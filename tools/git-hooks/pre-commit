#!/bin/sh
# Carlito pre-commit gates. Bypass (rarely) with: git commit --no-verify
# Fast checks always run; the Godot bake check runs only when staged files touch
# levels/kit/authoring inputs.
set -e
# Godot binary: $GODOT_BIN -> `git config carlito.godotbin` -> `godot` on PATH.
# Resolved lazily in gate 4 (the only one that needs it), so a machine without it still
# gets the cheap gates. The git-config fallback exists because a commit from an IDE, a GUI or a
# fresh shell carries no session $GODOT_BIN (a hook inherits only its caller's environment).
resolve_godot() {
  GODOT="$GODOT_BIN"
  [ -n "$GODOT" ] || GODOT=$(git config --get carlito.godotbin || true)
  if [ -n "$GODOT" ]; then
    if [ ! -x "$GODOT" ] && [ ! -f "$GODOT" ]; then
      echo "pre-commit: configured Godot binary does not exist: $GODOT" >&2
      exit 1
    fi
  elif command -v godot >/dev/null 2>&1; then
    GODOT=godot
  else
    echo "pre-commit: Godot not found. Set it once for this clone with:" >&2
    echo "  git config carlito.godotbin '<path>/Godot_v4.7.1-stable_win64_console.exe'" >&2
    echo "(or export GODOT_BIN, or put godot on PATH)" >&2
    exit 1
  fi
}
staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

# 1. Editor-only classes as type annotations outside addons/ parse-fail in exported
#    builds (the node silently does nothing — this emptied the deployed terrain once).
gd_staged=$(echo "$staged" | grep '\.gd$' | grep -v '^addons/' || true)
if [ -n "$gd_staged" ]; then
  bad=$(echo "$gd_staged" | xargs grep -nE '^[^#]*((:|->)[[:space:]]*|Array\[|[[:space:]]as[[:space:]]+)Editor[A-Z][A-Za-z0-9]*' 2>/dev/null || true)
  if [ -n "$bad" ]; then
    echo "pre-commit: editor-only type annotation in runtime script (breaks exported builds):"
    echo "$bad"
    echo "Fix: fetch via Engine.get_singleton(&\"EditorInterface\") into an UNTYPED var."
    exit 1
  fi
fi

# 2. Contract edited -> synced sloppyCAN copy must be regenerated.
if echo "$staged" | grep -q '^contract/carlito_contract\.json$'; then
  out="../sloppycan/carlito_contract.js"
  before=$(git hash-object "$out" 2>/dev/null || echo none)
  node tools/gen_js_contract.mjs
  after=$(git hash-object "$out" 2>/dev/null || echo regen-failed)
  if [ "$before" != "$after" ]; then
    echo "pre-commit: sloppyCAN contract copy was stale — just regenerated it."
    echo "Review + commit it in the sloppycan repo, then re-run this commit."
    exit 1
  fi
fi

# 3. Head include touched -> pasted preset copy must match the reviewable source.
if echo "$staged" | grep -qE '^(src/bridge/web/head_include\.html|export_presets\.cfg)$'; then
  node tools/check_head_include.mjs || exit 1
fi

# 4. Bake inputs touched -> stale-bake + road-paint check (same gate CI runs, ~30s). The
#    prefixes are tools/git-hooks/bake_paths.txt, shared with the Stop hook.
bake_re=$(tr -d '\r' < tools/git-hooks/bake_paths.txt | grep -vE '^(#|$)' | sed 's/\./\\./g; s/^/^/' | awk 'NR>1{printf "|"}{printf "%s", $0}')
[ -n "$bake_re" ] || { echo "pre-commit: tools/git-hooks/bake_paths.txt is missing or empty" >&2; exit 1; }
if echo "$staged" | grep -v '\.md$' | grep -qE "$bake_re"; then
  echo "pre-commit: bake inputs staged — running stale-bake check..."
  resolve_godot
  # Judged by output, not exit code (root CLAUDE.md): same patterns as tools/preflight.ps1.
  bakes_out=$("$GODOT" --headless --path . res://tools/check_bakes.tscn 2>&1 || true)
  echo "$bakes_out"
  if echo "$bakes_out" | grep -qE '\[check-bakes\].*: (stale|missing|error)'; then
    echo "pre-commit: stale bakes or road paint (fix named above), then:  & \$GODOT --headless --path . res://tools/bake_levels.tscn"
    exit 1
  fi
  if ! echo "$bakes_out" | grep -q '\[check-bakes\] complete:'; then
    echo "pre-commit: check_bakes printed no completion sentinel — the run did not finish"
    exit 1
  fi
fi

# 5. project.godot touched -> restore the frozen 60 Hz physics pin (rule 9) if the
#    editor's UI-save dropped a value equal to its own built-in default.
if echo "$staged" | grep -q '^project\.godot$'; then
  fixed=0
  # pin_setting <key> <value>: rewrite a wrong value in place, else add the key under
  # [physics], else append the whole section.
  pin_setting() {
    grep -q "^$1=$2\$" project.godot && return 0
    fixed=1
    if grep -q "^$1=" project.godot; then
      sed -i "s|^$1=.*|$1=$2|" project.godot
    elif grep -q '^\[physics\]$' project.godot; then
      sed -i "/^\[physics\]\$/a $1=$2" project.godot
    else
      printf '\n[physics]\n\n%s=%s\n' "$1" "$2" >> project.godot
    fi
  }
  pin_setting common/physics_ticks_per_second 60
  pin_setting common/physics_interpolation true
  if ! grep -q '^common/physics_ticks_per_second=60$' project.godot \
      || ! grep -q '^common/physics_interpolation=true$' project.godot; then
    echo "pre-commit: could not restore the 60 Hz physics pin in project.godot (rule 9)" >&2
    exit 1
  fi
  if [ "$fixed" = 1 ]; then
    git add project.godot
    echo "pre-commit: restored the 60 Hz physics pin in project.godot (rule 9)."
  fi
fi
exit 0
