#!/bin/sh
# Carlito pre-commit gates. Bypass (rarely) with: git commit --no-verify
# Fast checks always run; the Godot bake check runs only when staged files touch
# levels/kit/authoring inputs.
set -e
staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

# 1. Text damage a scripted edit leaves and the tests miss (a glued `\` continuation), and
#    editor-only type annotations that parse-fail in exported builds.
gd_staged=$(echo "$staged" | grep '\.gd$' | grep -v '^addons/' || true)
if [ -n "$gd_staged" ]; then
  gd_text=$(echo "$gd_staged" | xargs node tools/check_gd_text.mjs) || { echo "$gd_text"; exit 1; }
fi

# 2. Contract edited -> synced sloppyCAN copy must be regenerated.
if echo "$staged" | grep -q '^contract/carlito_contract\.json$'; then
  node tools/gen_js_contract.mjs --check || { echo "pre-commit: then re-run this commit."; exit 1; }
fi

# 3. Head include touched -> pasted preset copy must match the reviewable source.
if echo "$staged" | grep -qE '^(src/bridge/web/head_include\.html|export_presets\.cfg)$'; then
  node tools/check_head_include.mjs || exit 1
fi

# 3b. A doc touched -> references, budgets and the measured-figure ratchet (node, ~1 s).
if echo "$staged" | grep -qE '(^|/)CLAUDE\.md$|^docs/.*\.md$'; then
  node tools/check_docs.mjs || exit 1
fi

# 4. Bake inputs touched -> stale-bake + road-paint check (same gate CI runs, ~30s). The
#    prefixes are tools/git-hooks/bake_paths.txt, shared with the Stop hook.
bake_re=$(tr -d '\r' < tools/git-hooks/bake_paths.txt | grep -vE '^(#|$)' | sed 's/\./\\./g; s/^/^/' | awk 'NR>1{printf "|"}{printf "%s", $0}')
[ -n "$bake_re" ] || { echo "pre-commit: tools/git-hooks/bake_paths.txt is missing or empty" >&2; exit 1; }
if echo "$staged" | grep -v '\.md$' | grep -qE "$bake_re"; then
  echo "pre-commit: bake inputs staged — running stale-bake check..."
  # Judged by output, not exit code (root CLAUDE.md). A run already holding the checkout makes
  # godot_run refuse, which fails the commit: commit when it ends.
  bakes_out=$(node tools/godot_run.mjs -- --headless --path . res://tools/check_bakes.tscn 2>&1 || true)
  echo "$bakes_out"
  echo "$bakes_out" | node tools/godot_verdict.mjs --bakes || exit 1
fi

exit 0
