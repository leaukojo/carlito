# Every text file is LF in the index AND the working tree, whatever a clone's core.autocrlf:
# Godot and Claude's edit tools write LF, so a CRLF checkout ends up with mixed-ending files
# that exact-match edits miss. After changing this, an existing clone re-checks out once
# (tools/setup_machine.ps1 does it when the tree is clean).
* text=auto eol=lf

# cmd.exe misparses labels in LF batch files.
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets: never eol-convert, never diff as text.
*.png binary
*.jpg binary
*.glb binary
*.ttf binary
*.wav binary
*.ogg binary
*.scn binary
*.ctex binary
