[resource]
script = ExtResource("6_rf4m6")
id = "dev_box_stop_fog"
title = "DEV: Stop in the box (fog)"
variant = "sedan-sports"
arena = "flatland"
course = "res://src/challenges/dev/dev_box_stop_course.tscn"
spawn_jitter_m = 1.0
spawn_jitter_deg = 5.0
briefing = "Development course on flatland. Drive through the white gate line 30 m ahead, then stop with all four wheels inside the yellow box 60 m ahead and hold still for 1 s. The red strip on the right is a ditch: entering it respawns you and starts the attempt over. Par 60 s. Heavy fog: the box is straight ahead of the start."
hint = "speed and brake. Stopped means the body's velocity under 0.1 m/s, held for 1 s; speed is 0.01 m/s on the wire."
par_s = 60.0
visibility = 2
fog_density = 0.12
goals = Array[ExtResource("3_ehteu")]([SubResource("Resource_npu70"), SubResource("Resource_ohswp")])
constraints = Array[ExtResource("1_ffa31")]([SubResource("Resource_5oivn")])
