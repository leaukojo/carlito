[resource]
script = ExtResource("6_pq5m8")
id = "dev_box_stop_dark"
title = "DEV: Stop in the box (dark)"
variant = "sedan-sports"
arena = "flatland"
course = "res://src/challenges/dev/dev_box_stop_course.tscn"
spawn_jitter_m = 1.0
spawn_jitter_deg = 5.0
briefing = "Development course on flatland. Drive through the white gate line 30 m ahead, then stop with all four wheels inside the yellow box 60 m ahead and hold still for 1 s. The red strip on the right is a ditch: entering it respawns you and starts the attempt over. Par 60 s. Pitch black: turn the headlights on to find the gate and the box."
hint = "speed and brake. Stopped means the body's velocity under 0.1 m/s, held for 1 s; speed is 0.01 m/s on the wire."
par_s = 60.0
visibility = 1
goals = Array[ExtResource("3_klrtc")]([SubResource("Resource_8jdr6"), SubResource("Resource_20wyc")])
constraints = Array[ExtResource("1_j61vk")]([SubResource("Resource_e07kj")])
