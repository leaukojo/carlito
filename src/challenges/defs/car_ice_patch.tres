[gd_resource type="Resource" script_class="ChallengeDef" format=3]

[ext_resource type="Script" path="res://src/challenges/goals/challenge_goal.gd" id="1_goal"]
[ext_resource type="Script" path="res://src/challenges/goals/reach_zone_goal.gd" id="2_reach"]
[ext_resource type="Script" path="res://src/challenges/challenge_def.gd" id="3_def"]

[sub_resource type="Resource" id="Resource_finish"]
script = ExtResource("2_reach")
zone = &"Finish"

[resource]
script = ExtResource("3_def")
id = "car_ice_patch"
title = "Ice patch"
variant = "sedan-sports"
arena = "car_arena"
course = "res://src/levels/island/car_arena/courses/car_ice_patch_course.tscn"
briefing = "Reach the finish line past the bend. Somewhere on this road the grip drops, and nothing on the road shows where."
hint = "slip (two values, front and rear axle: mean wheel slip ratio), speed, accel, steer. When slip spikes, the tyres have let go: ease off accel until it settles, the way traction control does. The bend is 35 m radius over 70 deg."
goals = Array[ExtResource("1_goal")]([SubResource("Resource_finish")])
