[gd_resource type="Resource" script_class="ChallengeDef" format=3]

[ext_resource type="Script" path="res://src/challenges/goals/challenge_goal.gd" id="1_goal"]
[ext_resource type="Script" path="res://src/challenges/goals/signal_reach_goal.gd" id="2_reach"]
[ext_resource type="Script" path="res://src/challenges/goals/stop_in_zone_goal.gd" id="3_stop"]
[ext_resource type="Script" path="res://src/challenges/challenge_def.gd" id="4_def"]

[sub_resource type="Resource" id="Resource_connected"]
script = ExtResource("2_reach")
signal_name = "trailer_connected"
low = 1.0
high = 1.0

[sub_resource type="Resource" id="Resource_box"]
script = ExtResource("3_stop")
zone = &"Box"

[resource]
script = ExtResource("4_def")
id = "truck_couple_deliver"
title = "[NOT-TESTED] Couple and deliver"
variant = "semi"
attachment = ""
allow_attach_key = true
arena = "flatland"
course = "res://src/challenges/courses/truck_couple_deliver_course.tscn"
briefing = "Coupling has no CAN signal, so E still works here. Couple, confirm trailer_connected, then stop the rig in the box in time."
hint = "Coupling costs air pressure and takes a few seconds to recharge -- don't brake hard right away."
par_s = 35.0
goals = Array[ExtResource("1_goal")]([SubResource("Resource_connected"), SubResource("Resource_box")])
