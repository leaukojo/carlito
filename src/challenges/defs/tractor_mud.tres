[gd_resource type="Resource" script_class="ChallengeDef" format=3]

[ext_resource type="Script" path="res://src/challenges/goals/challenge_goal.gd" id="1_goal"]
[ext_resource type="Script" path="res://src/challenges/goals/reach_zone_goal.gd" id="2_reach"]
[ext_resource type="Script" path="res://src/challenges/challenge_def.gd" id="3_def"]

[sub_resource type="Resource" id="Resource_far"]
script = ExtResource("2_reach")
zone = &"Far"

[resource]
script = ExtResource("3_def")
id = "tractor_mud"
title = "[NOT-TESTED] Mud"
variant = "tractor-kenney"
arena = "level_1"
course = "res://src/levels/island/level_1/courses/tractor_mud_course.tscn"
briefing = "Drive north through the wallow and clear the far side before the par time runs out."
hint = "wheel_slip (ISO wheel-based speed against ground speed) says how much a wheel is spinning uselessly. diff_lock and fwd_drive are both request bits with no keyboard key -- send them from sloppyCAN's tractor dashboard panel and watch wheel_slip fall when they bite."
par_s = 30.0
goals = Array[ExtResource("1_goal")]([SubResource("Resource_far")])
