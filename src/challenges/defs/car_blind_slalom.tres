[resource]
script = ExtResource("3_def")
id = "car_blind_slalom"
title = "Blind slalom"
variant = "sedan-sports"
arena = "flatland"
course = "res://src/challenges/courses/car_blind_slalom_course.tscn"
briefing = "Heavy fog again, and six invisible cones. Pass within 2.5 m of each, in order (a cone reached out of turn does not count). You start facing north. 1: lat 48.8568695, lon 2.3521317. 2: lat 48.8571390, lon 2.3522683. 3: lat 48.8574085, lon 2.3521317. 4: lat 48.8576780, lon 2.3522683. 5: lat 48.8579475, lon 2.3521317. 6: lat 48.8582170, lon 2.3522683. No par."
hint = "lat, lon (1e-7 deg, about 1 cm), heading (0.1 deg, 0 = north), steer. Around here 0.00001 deg of latitude is 1.113 m and 0.00001 deg of longitude is 0.732 m. The bearing to the next cone minus your heading is the steering error."
visibility = 2
fog_density = 0.12
goals = Array[ExtResource("1_goal")]([SubResource("Resource_c1"), SubResource("Resource_c2"), SubResource("Resource_c3"), SubResource("Resource_c4"), SubResource("Resource_c5"), SubResource("Resource_c6")])
