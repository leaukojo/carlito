[gd_resource type="Resource" script_class="ChallengeDef" format=3]

[ext_resource type="Script" path="res://src/challenges/goals/challenge_goal.gd" id="1_goal"]
[ext_resource type="Script" path="res://src/challenges/goals/signal_band_goal.gd" id="2_band"]
[ext_resource type="Script" path="res://src/challenges/challenge_def.gd" id="3_def"]

[sub_resource type="Resource" id="Resource_row"]
script = ExtResource("2_band")
zone = &"Row"
exit_zone = &"Exit"
signal_name = "engine_load"
low = 12.0
high = 70.0

[resource]
script = ExtResource("3_def")
id = "tractor_plough"
title = "[NOT-TESTED] Plough"
variant = "tractor-kenney"
attachment = "res://src/vehicles/tractor/implements/plough.tscn"
arena = "level_1"
course = "res://src/levels/island/level_1/courses/tractor_plough_course.tscn"
briefing = "Lower the plough into the field, then hold a straight furrow with engine_load in band."
hint = "The plough only bites near the bottom of the hitch stroke. engine_load peaks mid-throttle, not at max."
goals = Array[ExtResource("1_goal")]([SubResource("Resource_row")])
