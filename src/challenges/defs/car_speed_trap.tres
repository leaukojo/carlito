[gd_resource type="Resource" script_class="ChallengeDef" format=3]

[ext_resource type="Script" path="res://src/challenges/goals/challenge_goal.gd" id="1_goal"]
[ext_resource type="Script" path="res://src/challenges/goals/signal_band_goal.gd" id="2_band"]
[ext_resource type="Script" path="res://src/challenges/challenge_def.gd" id="3_def"]

[sub_resource type="Resource" id="Resource_trap"]
script = ExtResource("2_band")
signal_name = "kmh"
low = 48.0
high = 52.0
zone = &"Trap"
exit_zone = &"TrapExit"

[resource]
script = ExtResource("3_def")
id = "car_speed_trap"
title = "Speed trap"
variant = "sedan-sports"
arena = "car_arena"
course = "res://src/levels/island/car_arena/courses/car_speed_trap_course.tscn"
briefing = "Hold 50 km/h, plus or minus 2 (48 to 52 on kmh), the whole way through a 160 m trap on the straight: from the amber line 110 m ahead of the start to the white line 270 m ahead. Leave the trap across the white line; leaving it by the side of the road fails. This car has no speed limiter and no cruise control, so build your own. No par."
hint = "kmh, speed (0.01 m/s), accel and brake (0-100 %), gear 0 for the automatic box. A proportional controller: accel = k * (50 - kmh), plus a steady bias to hold the speed against drag. Too much k and it oscillates through the band."
goals = Array[ExtResource("1_goal")]([SubResource("Resource_trap")])
