[gd_resource type="Resource" script_class="ChallengeDef" format=3]

[ext_resource type="Script" path="res://src/challenges/goals/challenge_goal.gd" id="1_goal"]
[ext_resource type="Script" path="res://src/challenges/goals/stop_in_zone_goal.gd" id="2_stop"]
[ext_resource type="Script" path="res://src/challenges/challenge_def.gd" id="3_def"]
[ext_resource type="Script" path="res://src/challenges/goals/challenge_constraint.gd" id="4_cons"]
[ext_resource type="Script" path="res://src/challenges/goals/fail_zone_constraint.gd" id="5_fail"]

[sub_resource type="Resource" id="Resource_bay"]
script = ExtResource("2_stop")
zone = &"Bay"
heading_deg = 180.0
heading_tol_deg = 20.0

[sub_resource type="Resource" id="Resource_behind"]
script = ExtResource("5_fail")
zone = &"Behind"
warning = "Came in from behind the bay"

[resource]
script = ExtResource("3_def")
id = "car_reverse_park"
title = "Reverse park"
variant = "sedan-sports"
arena = "car_arena"
course = "res://src/levels/island/car_arena/courses/car_reverse_park_course.tscn"
briefing = "Show us your reverse parking skills!"
hint = "Just find out the reverse gear, it's not complicated from there."
goals = Array[ExtResource("1_goal")]([SubResource("Resource_bay")])
constraints = Array[ExtResource("4_cons")]([SubResource("Resource_behind")])
