[gd_resource type="Resource" script_class="ChallengeDef" format=3]

[ext_resource type="Script" path="res://src/challenges/goals/challenge_goal.gd" id="1_goal"]
[ext_resource type="Script" path="res://src/challenges/goals/signal_reach_goal.gd" id="2_reach"]
[ext_resource type="Script" path="res://src/challenges/challenge_def.gd" id="3_def"]

[sub_resource type="Resource" id="Resource_scale"]
script = ExtResource("2_reach")
signal_name = "axle_load"
low = 5900.0
high = 6700.0
zone = &"Scale"
hold_s = 1.0

[resource]
script = ExtResource("3_def")
id = "truck_weighbridge"
title = "[NOT-TESTED] Weighbridge"
variant = "garbage-truck"
arena = "flatland"
course = "res://src/challenges/courses/truck_weighbridge_course.tscn"
briefing = "Load the hopper until axle_load sits in the target band, then hold it on the scale."
hint = "Each dump adds load, but only part reaches the rear axle -- target 5900-6700 kg. Only a respawn resets it."
goals = Array[ExtResource("1_goal")]([SubResource("Resource_scale")])
