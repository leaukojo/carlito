[gd_resource type="Resource" script_class="ChallengeDef" format=3]

[ext_resource type="Script" path="res://src/challenges/goals/challenge_goal.gd" id="1_goal"]
[ext_resource type="Script" path="res://src/challenges/goals/signal_reach_goal.gd" id="2_reach"]
[ext_resource type="Script" path="res://src/challenges/challenge_def.gd" id="3_def"]

[sub_resource type="Resource" id="Resource_dumped"]
script = ExtResource("2_reach")
signal_name = "hopper_load"
low = 12.5
high = 100.0
hold_s = 0.2

[resource]
script = ExtResource("3_def")
id = "truck_tipping_refused"
title = "[NOT-TESTED] Tipping refused"
variant = "garbage-truck"
arena = "flatland"
course = "res://src/challenges/courses/truck_tipping_refused_course.tscn"
briefing = "body_cmd does nothing yet. Find the interlock and complete one lift/dump cycle."
hint = "body_inhibit is one bit for engine running, chassis PTO on, road speed at or below walking pace, and the handbrake applied. body_bus says whether the PTO term is the one still missing. A frame-sent lift holds only while its command keeps arriving. hopper_load rises 12.5% per completed dump."
goals = Array[ExtResource("1_goal")]([SubResource("Resource_dumped")])
