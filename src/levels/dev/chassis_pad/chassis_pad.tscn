[sub_resource type="Shader" id="KerbShader"]
code = "shader_type spatial;
// Red and white kerb stripes, one metre each along the kerb (local z).
varying float along;
void vertex() {
	along = VERTEX.z;
}
void fragment() {
	ALBEDO = mod(floor(along), 2.0) < 1.0 ? vec3(0.75, 0.10, 0.08) : vec3(0.92, 0.92, 0.9);
	ROUGHNESS = 0.8;
}
"

[sub_resource type="ShaderMaterial" id="KerbMat"]
