; The camera gimbal: DroneGimbalMount turns the yoke about y and the camera about x, the same two
; factors it writes onto HoodCam, which sits on the crossing of the two axes.
[node name="GimbalYaw" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.012, -0.31)

[node name="Yoke" parent="GimbalYaw" instance=ExtResource("6_yoke")]

[node name="GimbalPitch" type="Node3D" parent="GimbalYaw"]

[node name="Camera" parent="GimbalYaw/GimbalPitch" instance=ExtResource("7_camera")]

[node name="HoodCam" type="Marker3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.012, -0.31)

; The cargo hook: DroneVehicle casts the capture ray straight down from here and hangs the payload
; off it. The jaws are drawn shut on a closed latch (DroneHook); the right one is the left turned
; half round.
[node name="Hardpoint" type="Marker3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.059, 0)

[node name="JawL" parent="Hardpoint" instance=ExtResource("8_jaw")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.012, 0.019, 0)

[node name="JawR" parent="Hardpoint" instance=ExtResource("8_jaw")]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, 0.012, 0.019, 0)

; The forward spotlight on the `lights` ladder, aircraft style (LampSet via drone_spec.tres).
[node name="HeadLight" type="SpotLight3D" parent="."]
