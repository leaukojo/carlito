; drone.tscn's airframe numbers exactly (same script, spec, exports and collision box), so every
; pinned flight figure holds; only the body differs. tools/gen_drone_model.py builds the parts, and
; every rig node below sits on the Body's Pivot_<name> empty (test_drone_indicators pins them).
[node name="DroneMk2" type="RigidBody3D"]
physics_material_override = SubResource("HullPhysMat")
script = ExtResource("1_drone")
spec = ExtResource("2_spec")

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.06, 0)
shape = SubResource("HullShape")

[node name="Body" parent="." instance=ExtResource("3_body")]

; The four rotors, MOTORS order. The prop's hand follows MOTORS' spin: +1 is counter-clockwise
; seen from above. `Blur` is the rotor-wash disc DroneMotors fades in with that motor's speed.
[node name="RotorFL" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.407, 0.15, -0.407)

[node name="Prop" parent="RotorFL" instance=ExtResource("4_ccw")]

[node name="Blur" type="MeshInstance3D" parent="RotorFL"]
cast_shadow = 0
mesh = SubResource("BlurMesh")

[node name="RotorFR" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.407, 0.15, -0.407)

[node name="Prop" parent="RotorFR" instance=ExtResource("5_cw")]

[node name="Blur" type="MeshInstance3D" parent="RotorFR"]
cast_shadow = 0
mesh = SubResource("BlurMesh")

[node name="RotorRL" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.407, 0.15, 0.407)

[node name="Prop" parent="RotorRL" instance=ExtResource("5_cw")]

[node name="Blur" type="MeshInstance3D" parent="RotorRL"]
cast_shadow = 0
mesh = SubResource("BlurMesh")

[node name="RotorRR" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.407, 0.15, 0.407)

[node name="Prop" parent="RotorRR" instance=ExtResource("4_ccw")]

[node name="Blur" type="MeshInstance3D" parent="RotorRR"]
cast_shadow = 0
mesh = SubResource("BlurMesh")

