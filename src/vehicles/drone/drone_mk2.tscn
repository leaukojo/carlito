; The rangefinder beam leaves the lens here; DroneIndicators poses it in world space to the ground
; the sensor measured. Authored as a 1 cm stub: hidden, it still counts toward the card framing's
; bounds, and a unit-length beam there would shrink the drone on its card.
[node name="RangeBeam" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 0.01, 0, 0, 0, 1, 0, -0.034, 0.11)
visible = false
cast_shadow = 0
material_override = SubResource("BeamMat")
mesh = SubResource("BeamMesh")
