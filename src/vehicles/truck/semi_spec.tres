[gd_resource type="Resource" script_class="VehicleSpec" load_steps=5 format=3]

; Cab-over tractor unit. HAND-AUTHORED, like train_spec.tres — this variant is not
; in gen_kenney_vehicles.gd's VARIANTS (Kenney ships no semi), so there is no generator baseline
; behind it and every flag has to be right here or it is simply absent.
;
; THE DRIVETRAIN AND BRAKE BLOCK IS NO LONGER THE GARBAGE TRUCK'S — a TRACTOR UNIT IS THE ONLY
; TRUCK HERE THAT TOWS 24 t, and it was specced as if it did not. At the old 1040 Nm peak (a 7-litre
; medium truck) a 32 t rig could not pull away up a grade, which is honest for that engine and wrong
; for this vehicle: a European artic runs an 11-13 L six. There is no clutch or converter model, so
; pulling away is decided by the torque at IDLE, and the old curve's 520 Nm there was the actual
; complaint. The shipped curve peaks at 1500 Nm and holds 975 at idle (65 % of peak, which is the
; shape of a real truck diesel and not of the car curve this was scaled from) — 0-100 % throttle at
; rest now makes 71 kN at the wheel against 38 kN before, i.e. a laden rig starts on a ~20 % grade
; where it used to stall on 11 %. The rpm range is untouched, so every rpm-dependent tune (shift
; points, engine_load's peak-torque denominator, the retarder fade) still means what it meant.
;
; WHAT BOUNDS 1500 Nm IS TRACTION, NOT THE BRAKE CHAIN. tests/test_truck.gd requires brake >
; TRANSMISSIBLE drive, i.e. against min(peak drive, driven wheels x per-wheel grip), and on a truck
; tyre the tyre is the smaller: 2 x 0.80 x 19600 N x 0.36 = 11290 Nm against 42000 Nm of service
; brake, so nothing in the suite bounds peak engine torque any more. The real limit is the road —
; gear 1 puts 1500 x 6.5 x 4.5 x 0.9 / 0.36 = 110 kN at the tyres against ~66 kN of coupled
; drive-axle grip (92 kN of axle load x mu 0.80 x the 0.90 load-sensitivity factor), so the rig is
; 1.65x traction-limited off the line and a bigger engine buys wheelspin. A real 32 t artic makes
; 2300-2800 Nm; getting there is ballast and plate share, not torque.
;
; brake_torque 10500 IS NOT GRIP-DERIVED (unlike every Kenney body), and what bounds it is the
; retarder band above and the tyre below. Above: retarder_rating is a FRACTION of it, so
; 0.20 * B * 2 / 0.36 / 8000 must stay under 1.6 m/s^2 and B < 11520; shipped B = 10500 gives a
; 1.46 m/s^2 retarder. Below: at mu 0.80 the coupled rig's per-wheel static load is 3618 kg, whose
; own grip ceiling is 10213 Nm — so 10500 sits AT the coupled tyre, which is the point of it.
; ACCEPTED COMPROMISE: one brake_torque serves all four corners while the coupled axle loads split
; about 1:1.9 (steer 2527 kg, drive 4709 kg), so the steer axle's own ceiling is 7132 Nm and a
; FLOORED pedal locks the front before the rear — the wrong way round for a real rig, which fits a
; load-sensing valve. Undoing it is brake apportioning, a new mechanism, not a number here; part
; pedal is unaffected because RayWheel's slip tyre saturates rather than stepping.
;
; handbrake_torque 4800 is likewise pinned by construction, not tuned: the same test holds the total
; handbrake inside (25 %, 50 %) of the drive torque at idle, and that window MOVED with the engine
; (3209-6417 per wheel now). 4800 sits mid-window. It is nowhere near enough to park 32 t on its own
; — see the trailer specs, which is where a rig's parking brake actually lives.
;
; trailer_bus_equipped IS THE ISO 7638 CONNECTOR'S DATA PAIR, and it is a flag rather than an
; assumption because the whole trailer bus is regional: this European unit has pins 6 and 7, so a
; coupled trailer claims and the ISO 11992 cluster comes alive. A unit without it tows exactly the
; same trailer, brakes it exactly the same way through the pneumatic lines, and publishes
; trailer_connected FALSE with honest zeros behind it.
;
; Geometry is measured off semi.tscn: 5.45 m long (front bumper z -3.74 to rear bumper +1.71),
; wheelbase 3.60 (steer axle -2.65 under the cab, drive axle +0.95), 1.92 wide like
; the rest of the family. THE CAB SITS OVER THE STEER AXLE (it spans -3.60 .. -1.40) AND THE PLATE
; 0.50 m AHEAD OF THE DRIVE AXLE, both for the silhouette: a cab-over's cab is the front axle's
; housing, and a fifth wheel that far back leaves a bare frame behind the cab and a metre of
; daylight between cab and trailer. Neither number is free of the launch tune below — the axles
; did not move.
;
; THE WHEELBASE IS SIZED BY THE LAUNCH, not by the silhouette: the trailer
; pulls at the 1.05 m kingpin, and on a short unit that lever beats the steer axle's share of the
; weight — measured, a 2.10 m wheelbase lifted BOTH front wheels clear of the road for ~1 s of
; every full-throttle gear-1 launch, while 3.60 keeps the axle loaded throughout. Shortening it
; again is a re-measure, not a styling choice.
;
; CENTRE OF MASS IS FORWARD OF CENTRE, WHICH LOOKS WRONG UNTIL YOU COUPLE IT. A cab-over's own mass
; is cab and engine, both over the steer axle, so a BOBTAIL tractor unit is front-heavy — steer
; share = (drive_z - com_z) / wheelbase — which is why real bobtails are notoriously easy to lock
; up. Coupled to the box the plate's weight lands mostly on the drive axle —
; Articulation.rear_axle_share(kingpin_z, steer_z, drive_z), the kingpin sitting 0.50 m ahead of it.
; Both bands, plus the coupled steer axle's own floor, are pinned per tractor unit in
; tests/test_trailer.gd. Driving found the bias: further back, the coupled steer axle carried about
; a fifth of the rig's weight and BOTH front wheels left the road under throttle in a corner, i.e.
; the rig lost its steering exactly when it needed it — the floor tests/test_trailer.gd holds today
; is well clear of that fifth.
;
; CENTRE OF MASS HEIGHT 0.90 IS ~1.03 m OVER THE ROAD — the body origin rides ~0.13 m up coupled,
; which is how measure_semi_launch's P5 reads it back (kingpin_y 1.18 minus KINGPIN_LOCAL.y 1.05).
; A real tractor unit carries its mass about a metre up: engine, gearbox and frame, with a cab over
; all of it. At the old 0.35 (half that) the unit could not lean, could not transfer load and could
; not roll, which is the flat "video game" feel the whole family had. What the height costs is
; real: the steer axle sheds weight under a gear-1 launch (the >= 8.5 kN floor is measured, not
; assumed), and bobtail the unit tips at half-track 0.72 / 1.09 m = 0.66 g against mu_lat 0.75 —
; still slide-first, but only just. If it ever stops being, the lever is anti_roll_rate or mu_lat,
; never the height back down. truck/CLAUDE.md § The fifth wheel carries the per-trailer thresholds.
;
; THE SPRINGS ARE SIZED PER AXLE, because the rear carries the fifth-wheel load as well as its own:
; the drive axle is the ONLY driven axle, so what the plate puts on it (a realistic share of the
; trailer — kingpin_share, 25-30 % band pinned in tests/test_trailer.gd — mostly landing on this
; axle) IS the rig's traction budget, and it is also the load the rear
; spring has to carry inside the 0.32 m travel. Front rate 240000 N/m is the truck family's; the
; rear is spring_rate_rear = 360000, 1.5x, from rear_load / (target_travel * rest_length) with the
; coupled-to-the-box drive corner as the load and ~40 % as the target, which splits the error between
; laden (a few tenths nose-up) and bobtail (a few tenths nose-down) the way a real unit does.
; tests/test_trailer.gd computes the travel fractions from these numbers; measure_semi_launch
; reports the pose.
;
; REAR DAMPERS ARE SIZED FOR THE COUPLED CORNER, NOT THE SPRING-SCALE RULE. The rear axle's own
; load (own_rear_kg, ~1922 kg/corner bobtail) plus its share of a coupled trailer's kingpin load
; (kingpin_kg x rear_axle_share(kingpin_z, steer_z, drive_z)) puts ~3.5-4.7 t on each coupled rear
; corner depending on which of the four trailers is on the back (flatbed 14 t up to the box's
; 24 t). damper_bump_rear 24700 / damper_rebound_rear 28800 hold zeta = c / (2 sqrt(k_rear * m))
; between 0.30 (the box, heaviest) and 0.40 (the flatbed, lightest) across that range —
; tests/test_trailer.gd pins the band against the flatbed. The same numbers read as zeta 0.47/0.55
; at the bobtail corner mass (1922 kg), over-damped on purpose: an unladen truck skating over
; bumps rather than pitch-rocking is the honest bobtail feel. GroundDriveSpec's sqrt(rate ratio)
; fallback is what an UNSPECIFIED rear damper would get; this axle carries a load the front-axle
; scale rule was never sized for, so it is overridden explicitly instead.
;
; LOAD SENSITIVITY 0.08 IS WHERE THE PLATE LOAD SHOWS UP. RayWheel scales mu by
; `1 - 0.08 * log2(load / corner_mass*g)`, and corner_mass deliberately excludes the fifth-wheel
; share (truck/CLAUDE.md), so coupled to the box each drive wheel sits ~2.35x its reference and
; holds ~90 % of mu_long while the steer axle is untouched. That is the laden drive axle really
; losing grip, and it is the conservative direction — the understated reference can only make the
; tyre read MORE overloaded, never less. Re-measure with tools/measure_semi_launch.tscn.

[ext_resource type="Script" path="res://src/vehicles/base/vehicle_spec.gd" id="1_spec"]
[ext_resource type="PackedScene" path="res://src/vehicles/kenney/wheel-truck.tscn" id="2_wheel"]
[ext_resource type="Script" path="res://src/vehicles/base/ground_drive_spec.gd" id="3_grounddrive"]

; DRAG AREA 2.18 m^2 = 0.70 (a flat-fronted cab-over) x 0.82 x the cab's own 1.92 x 1.98 box, i.e.
; the same Cd x 0.82 x w x h recipe gen_kenney_vehicles derives every generated spec from — the
; number is measured off semi.tscn's collision boxes rather than chosen, so a re-authored cab
; changes it for a reason. rolling_resistance 0.007 is a commercial radial.
;
; WHAT MAKES THIS A COMBINATION AND NOT A PENALTY: the trailer declares its OWN small drag area
; (box_spec 0.60 — see there for the wake argument) and BOTH bodies apply their own aero, so a
; coupled rig resists tractor + trailer = 2.78 m^2, about 1.27x a bobtail. The old per-mass engine
; damp made it 4x instead, because it read the 24 t rather than the shape.

[sub_resource type="Resource" id="Resource_grounddrive"]
script = ExtResource("3_grounddrive")
drag_area = 2.18
rolling_resistance = 0.007
wheel_positions = PackedVector3Array(-0.72, 0.424, -2.65, 0.72, 0.424, -2.65, -0.62, 0.424, 0.95, 0.62, 0.424, 0.95)
wheel_radius = 0.36
wheel_inertia = 3.0
wheel_scene = ExtResource("2_wheel")
driven_front = false
driven_rear = true
retarder_equipped = true
rest_length = 0.32
spring_rate = 240000.0
damper_bump = 12000.0
damper_rebound = 15800.0
spring_rate_rear = 360000.0
damper_bump_rear = 24700.0
damper_rebound_rear = 28800.0
max_suspension_force = 120000.0
grip_curve = PackedVector2Array(0, 0, 0.12, 1, 0.4, 0.9, 1, 0.8)
mu_long = 0.8
mu_lat = 0.75
load_sensitivity = 0.08
handbrake_grip = 1.0
brake_torque = 10500.0
handbrake_torque = 4800.0
max_steer_deg = 24.0
min_steer_frac = 0.21
steer_falloff_speed = 25.0

[resource]
script = ExtResource("1_spec")
mass = 8000.0
center_of_mass = Vector3(0, 0.9, -0.92)
ground_drive = SubResource("Resource_grounddrive")
trailer_bus_equipped = true
torque_curve = PackedVector2Array(700, 975, 1200, 1290, 1800, 1500, 2400, 1440, 2800, 1120, 3200, 375)
idle_rpm = 700.0
redline_rpm = 3200.0
gear_ratios = PackedFloat32Array(6.5, 3.7, 2.4, 1.6, 1.2, 1)
reverse_ratio = 6.0
final_drive = 4.5
efficiency = 0.9
engine_brake_frac = 0.15
shift_cut_s = 0.4
shift_up_rpm = 2600.0
shift_down_rpm = 1200.0
; ROAD-SPEED GOVERNOR 90 km/h: the EU goods-vehicle limiter (Directive 92/6/EEC). INERT AS
; GEARED — the 32 t rig settles at 82.7 km/h against drag, so it never acts — and declared
; anyway, because it is the honest spec for a European artic and it is what catches a later
; gearing change that would quietly put this unit over the legal figure.
speed_limit_kmh = 90.0
; HIGH-SPEED STEERING FALLOFF. 0.21 x 24 = 5.0 deg of usable lock at the floor, and the floor
; is set at 25 m/s = the 90 km/h limiter above, so the whole governed cruise sits on it. A
; coupled rig is the project's worst case for lock it cannot use: at 25 m/s mu_lat 0.75 holds
; only 2.4 deg of steady-state Ackermann on this 3.60 m wheelbase, so the 5.0 deg floor is 2.1x
; more lock than the tyre can use and the tyres (and the trailer) let go long before the rack
; runs out — tests/test_vehicle_catalog.gd's test_a_steering_taper_never_out_limits_the_tyres is
; where that ratio is pinned, and a lower mu_lat only widens it. Yard and junction work is
; untouched — 17.7 deg at 30 km/h, 20.8 at 15, and effectively the full 24 below walking pace,
; where the taper is single digits.
steer_speed = 1.8
headlight_paths = Array[NodePath]([NodePath("Lamps/HeadlightL"), NodePath("Lamps/HeadlightR")])
head_lamp_paths = Array[NodePath]([NodePath("Lamps/HeadLensL"), NodePath("Lamps/HeadLensR")])
brake_lamp_paths = Array[NodePath]([NodePath("Lamps/BrakeLampL"), NodePath("Lamps/BrakeLampR")])
turn_left_paths = Array[NodePath]([NodePath("Lamps/TurnLF"), NodePath("Lamps/TurnLR")])
turn_right_paths = Array[NodePath]([NodePath("Lamps/TurnRF"), NodePath("Lamps/TurnRR")])
