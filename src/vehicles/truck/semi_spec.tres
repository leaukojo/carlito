[gd_resource type="Resource" script_class="VehicleSpec" load_steps=5 format=3]

; Cab-over tractor unit. HAND-AUTHORED, like train_spec.tres: Kenney ships no semi, so there is no
; generator baseline and every flag must be right here or it is simply absent.
;
; DRIVETRAIN. This is the only truck here that tows 24 t, so the engine is an 11-13 L six: 2308 Nm
; at 1170 rpm, 2080 redline, 600 idle. The converter only lets a held rig rev to 970 rpm
; (Drivetrain.converter_free_rpm), so pulling away is decided by the LOW END of the curve: 1500 Nm at
; idle (65 % of the peak, the shape of a real truck diesel) and 2142 at 970 rpm. The launch grade it
; buys is measured in docs/vehicles.md § Gradeability. Shift points, engine_load's peak-torque
; denominator and the converter's stall all scale with the rpm range. The peak sits in a real 32 t
; artic's 2300-2800 Nm band.
;
; GEARS 1-5 x final_drive 2.925 are a road-speed ladder for that rpm range; 6th is an OVERDRIVE
; (0.69, 1.74x off 5th, about the 1.76x of 1st-2nd): ~1310 rpm at 88 km/h, a real unit's cruise, and
; the governor, not the redline, sets top speed. The 1690 upshift lands 6th at 972 rpm, clear of the
; 780 downshift, so no gear hunts.
;
; WHAT BOUNDS 2308 Nm IS TRACTION, NOT THE BRAKE CHAIN. tests/test_truck.gd requires brake >
; TRANSMISSIBLE drive = min(peak drive, driven wheels x per-wheel grip), and on a truck tyre the tyre
; is the smaller (2 x 0.80 x 19600 N x 0.36 = 11290 Nm against 42000 Nm of service brake), so no
; test bounds peak engine torque. The limit is the road: gear 1 puts 2308 x 6.5 x 2.925 x 0.9 / 0.36
; = 110 kN at the tyres against ~66 kN of coupled drive-axle grip (92 kN of axle load x mu 0.80 x
; the 0.90 load-sensitivity factor), so the rig is ~1.65x traction-limited off the line and a bigger
; engine buys wheelspin.
;
; brake_torque 10500 IS NOT GRIP-DERIVED (unlike every Kenney body). Above it: retarder_rating is a
; FRACTION of it, so 0.20 * B * 2 / 0.36 / 8000 must stay under 1.6 m/s^2 (B < 11520); 10500 gives
; 1.46 m/s^2. Below it: at mu 0.80 the coupled rig's per-wheel static load is 3618 kg, whose grip
; ceiling is 10213 Nm, so 10500 sits AT the coupled tyre.
; One brake_torque serves all four corners (no brake_bias_front) while the coupled axle loads split
; about 1:1.9 (steer 2527 kg, drive 4709 kg), so the steer axle's own ceiling is 7132 Nm: a FLOORED
; pedal asks the front for more than it can hold, and abs_equipped holds it at the grip peak, as a
; real rig's ABS does. Part pedal stays under every ceiling.
;
; handbrake_torque 4800 is pinned by construction: the same test holds the total handbrake inside
; (25 %, 50 %) of the drive torque at idle (3209-6417 per wheel), and 4800 sits mid-window. It
; cannot park 32 t alone; a rig's parking brake lives in the trailer specs.
;
; trailer_bus_equipped IS THE ISO 7638 CONNECTOR'S DATA PAIR, a flag because the trailer bus is
; regional: this European unit has pins 6 and 7, so a coupled trailer claims and the ISO 11992
; cluster comes alive. A unit without it tows and brakes the same trailer identically through the
; pneumatic lines and publishes trailer_connected FALSE with zeros behind it.
;
; GEOMETRY is measured off semi.tscn: 5.45 m long (front bumper z -3.74 to rear bumper +1.71),
; wheelbase 3.60 (steer axle -2.65 under the cab, drive axle +0.95), 1.92 wide like the rest of the
; family. THE CAB SITS OVER THE STEER AXLE (it spans -3.60 .. -1.40) AND THE PLATE 0.50 m AHEAD OF THE
; DRIVE AXLE, both for the silhouette: a fifth wheel further back leaves a bare frame behind the cab
; and a metre of daylight to the trailer. Neither is free of the launch tune below.
;
; THE WHEELBASE IS SIZED BY THE LAUNCH, not the silhouette: the trailer pulls at the 1.05 m
; kingpin, and on a short unit that lever beats the steer axle's share of the weight (a 2.10 m
; wheelbase lifts BOTH front wheels for ~1 s of every full-throttle gear-1 launch; 3.60 keeps the
; axle loaded). Shortening it is a re-measure, not a styling choice.
;
; CENTRE OF MASS IS FORWARD OF CENTRE, which looks wrong until you couple it. A cab-over's own mass
; is cab and engine over the steer axle, so a BOBTAIL unit is front-heavy (steer share =
; (drive_z - com_z) / wheelbase). Coupled to the box, the plate's weight lands mostly on the drive
; axle: Articulation.rear_axle_share(kingpin_z, steer_z, drive_z), kingpin 0.50 m ahead of it. Both
; bands, plus the coupled steer axle's own floor, are pinned per tractor unit in
; tests/test_trailer.gd; with the COM further back the coupled steer axle carries too little and
; both front wheels leave the road under throttle in a corner.
;
; CENTRE OF MASS HEIGHT 0.90 IS ~1.03 m OVER THE ROAD COUPLED, ~1.10 m BOBTAIL (the body origin
; rides 0.13 m up coupled, 0.20 m bobtail on its less-compressed rear springs: measure_semi_launch's
; P5 kingpin_y 1.18 / 1.25 minus KINGPIN_LOCAL.y 1.05). A real tractor unit carries its mass about
; a metre up; a low COM leaves the unit unable to lean, transfer load or roll. The cost is real: the
; steer axle sheds weight under a gear-1 launch (the >= 8.5 kN floor is measured, and gated in CI)
; and the bobtail's rigid ceiling (0.65 g) sits under mu_lat 0.75. The levers are anti_roll_rate
; or mu_lat, never the height back down. Rollover thresholds: docs/heavy_vehicles.md § Truck sizing.
;
; anti_roll_rate 480000 (2x the front spring) is sized by the TRAILER, not the bobtail: the plate
; lets the two bodies roll only +-1.5 deg apart, so a tractor that leans further than its trailer
; twists the trailer over through it (at 240000 the flatbed's trailer lifted at 0.42 g, here 0.50).
; It also holds the bobtail flat enough to slide (~0.55 g) before it lifts a wheel in a steady turn.
;
; THE SPRINGS ARE SIZED PER AXLE: the rear carries the fifth-wheel load as well as its own, and the
; drive axle is the ONLY driven axle, so what the plate puts on it (kingpin_share, a 25-30 % band
; pinned in tests/test_trailer.gd) IS the rig's traction budget and the load the rear spring
; carries inside the 0.32 m travel. Front rate 240000 N/m is the truck family's; the rear is
; spring_rate_rear = 360000 (1.5x), from rear_load / (target_travel * rest_length) with the
; coupled-to-the-box drive corner as the load and ~40 % as the target, which splits the error
; between laden (a few tenths nose-up) and bobtail (a few tenths nose-down). tests/test_trailer.gd
; computes the travel fractions; measure_semi_launch reports the pose.
;
; REAR DAMPERS ARE SIZED FOR THE COUPLED CORNER, not the spring-scale rule. The rear axle's own load
; (own_rear_kg, ~1922 kg/corner bobtail) plus its share of a coupled trailer's kingpin load
; (kingpin_kg x rear_axle_share) puts ~3.5-4.7 t on each coupled rear corner (flatbed 14 t to box
; 24 t). damper_bump_rear 24700 / damper_rebound_rear 28800 hold zeta = c / (2 sqrt(k_rear * m))
; between 0.30 (box) and 0.40 (flatbed); tests/test_trailer.gd pins the band against the flatbed.
; At the bobtail corner mass the same numbers read zeta 0.47/0.55, over-damped on purpose (an
; unladen truck skates over bumps rather than pitch-rocks). GroundDriveSpec's fallback would size
; an UNSPECIFIED rear damper off the front-axle rule, which this axle's load outgrows.
;
; LOAD SENSITIVITY 0.08 IS WHERE THE PLATE LOAD SHOWS UP. RayWheel scales mu by
; `1 - 0.08 * log2(load / corner_mass*g)`, and corner_mass excludes the fifth-wheel share
; (truck/CLAUDE.md § Fifth wheel, mass, axle loads), so coupled to the box each drive wheel sits
; ~2.35x its reference and holds ~90 % of mu_long while the steer axle is untouched: the laden
; drive axle really losing grip, the conservative direction. Re-measure with
; tools/measure_semi_launch.tscn.

[ext_resource type="Script" path="res://src/vehicles/base/vehicle_spec.gd" id="1_spec"]
[ext_resource type="PackedScene" path="res://src/vehicles/kenney/wheel-truck.tscn" id="2_wheel"]
[ext_resource type="Script" path="res://src/vehicles/base/ground_drive_spec.gd" id="3_grounddrive"]

; DRAG AREA 2.18 m^2 = 0.70 (a flat-fronted cab-over) x 0.82 x the cab's own 1.92 x 1.98 box: the
; Cd x 0.82 x w x h recipe gen_kenney_vehicles derives every generated spec from, measured off
; semi.tscn's collision boxes. rolling_resistance 0.007 is a commercial radial.
;
; The trailer declares its OWN small drag area (box_spec 0.60, see there for the wake argument) and
; BOTH bodies apply their own aero, so a coupled rig resists tractor + trailer = 2.78 m^2, about
; 1.27x a bobtail.

[sub_resource type="Resource" id="Resource_grounddrive"]
script = ExtResource("3_grounddrive")
drag_area = 2.18
rolling_resistance = 0.007
wheel_positions = PackedVector3Array(-0.72, 0.424, -2.65, 0.72, 0.424, -2.65, -0.62, 0.424, 0.95, 0.62, 0.424, 0.95)
wheel_radius = 0.36
wheel_inertia = 3.0
wheel_scene = ExtResource("2_wheel")
driven_front = false
driven_rear = true
retarder_equipped = true
rest_length = 0.32
spring_rate = 240000.0
damper_bump = 12000.0
damper_rebound = 15800.0
spring_rate_rear = 360000.0
damper_bump_rear = 24700.0
damper_rebound_rear = 28800.0
anti_roll_rate = 480000.0
max_suspension_force = 120000.0
grip_curve = PackedVector2Array(0, 0, 0.12, 1, 0.4, 0.9, 1, 0.8)
mu_long = 0.8
mu_lat = 0.75
load_sensitivity = 0.08
handbrake_grip = 1.0
brake_torque = 10500.0
handbrake_torque = 4800.0
abs_equipped = true
max_steer_deg = 24.0
min_steer_frac = 0.21
steer_falloff_speed = 25.0

[resource]
script = ExtResource("1_spec")
mass = 8000.0
center_of_mass = Vector3(0, 0.9, -0.92)
ground_drive = SubResource("Resource_grounddrive")
trailer_bus_equipped = true
torque_curve = PackedVector2Array(600, 1500, 780, 1985, 1170, 2308, 1560, 2215, 1820, 1723, 2080, 577)
idle_rpm = 600.0
redline_rpm = 2080.0
gear_ratios = PackedFloat32Array(6.5, 3.7, 2.4, 1.6, 1.2, 0.69)
reverse_ratio = 6.0
final_drive = 2.925
efficiency = 0.9
engine_brake_frac = 0.15
shift_cut_s = 0.4
shift_up_rpm = 1690.0
shift_down_rpm = 780.0
; ROAD-SPEED GOVERNOR 90 km/h: the EU goods-vehicle limiter (Directive 92/6/EEC). It binds: coupled
; or bobtail the unit settles on it at 88-89 km/h (measure_vehicles), ~1310 rpm in the overdrive 6th.
; It is the honest spec for a European artic.
speed_limit_kmh = 90.0
; HIGH-SPEED STEERING FALLOFF. 0.21 x 24 = 5.0 deg of usable lock at the floor, and the floor is set
; at 25 m/s = the 90 km/h limiter above, so the governed cruise sits on it. A coupled rig is the
; worst case for lock it cannot use: at 25 m/s mu_lat 0.75 holds only 2.4 deg of steady-state
; Ackermann on this 3.60 m wheelbase, so the 5.0 deg floor is 2.1x more lock than the tyre can use
; (test_a_steering_taper_never_out_limits_the_tyres in tests/test_vehicle_catalog.gd pins that
; ratio; a lower mu_lat only widens it). Yard work is untouched: 17.7 deg at 30 km/h, 20.8 at 15.
steer_speed = 1.8
headlight_paths = Array[NodePath]([NodePath("Lamps/HeadlightL"), NodePath("Lamps/HeadlightR")])
head_lamp_paths = Array[NodePath]([NodePath("Lamps/HeadLensL"), NodePath("Lamps/HeadLensR")])
brake_lamp_paths = Array[NodePath]([NodePath("Lamps/BrakeLampL"), NodePath("Lamps/BrakeLampR")])
turn_left_paths = Array[NodePath]([NodePath("Lamps/TurnLF"), NodePath("Lamps/TurnLR")])
turn_right_paths = Array[NodePath]([NodePath("Lamps/TurnRF"), NodePath("Lamps/TurnRR")])
