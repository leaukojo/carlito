[gd_resource type="Resource" script_class="VehicleSpec" load_steps=6 format=3]

; Cab-over tractor unit. HAND-AUTHORED, like train_spec.tres: Kenney ships no semi, so there is no
; generator baseline and every flag must be right here or it is simply absent.
;
; DRIVETRAIN. This is the only truck here that tows 24 t, so the engine is an 11-13 L six: 2308 Nm
; at 1170 rpm, 2080 redline, 600 idle. A pull-away slips the clutch at 900 rpm (see CRANK AND
; CLUTCH), so it is decided by the LOW END of the curve: 1500 Nm at idle (65 % of the peak, the
; shape of a real truck diesel) and 2084 at 900 rpm. The launch grade it
; buys is measured in docs/vehicle_measurements.md § Gradeability. Shift points, engine_load's peak-torque
; denominator and the launch target all scale with the rpm range. The peak sits in a real 32 t
; artic's 2300-2800 Nm band.
;
; CRANK AND CLUTCH. An 11-13 L six turns about 3.0 kg·m² at the crank, between a 5.5 L industrial
; diesel's published 1.50 (Volvo Penta TD640VE) and a 16.1 L genset's 4.20 (TAD1641GE), an
; estimate. Behind it is an AMT's dry clutch (coupling = CLUTCH) rated 2x the peak, 4616 Nm, a
; truck clutch's OE margin. The AMT launches holding the crank 300 rpm over idle, 900 rpm
; (launch_rpm_over_idle; Eaton, US 9,783,181), where the curve makes 2084 Nm. Through gear 1 the
; crank reflects 3.0 x 19.01^2 = 1084 kg·m² onto the drive wheels while the clutch is locked.
; Its friction (engine_friction_frac 0.05 of peak, ~115 Nm at and below idle) is scaled off the
; 16.1 L TAD1641GE's published friction power, 36 kW at 1500 rpm (229 Nm, FMEP 1.8 bar), to 12 L
; and idle (~1.2 bar), an estimate. It runs a lifted crank back to idle and a key-off one to rest.
; The pedal is the fuel (pedal_map LINEAR, the default): a road diesel's min-max governor leaves
; the injection pump's rack to the pedal (Bosch, Governors for In-Line Pumps, 1975). It burns
; diesel (fuel_type DIESEL): ~1.6 L/h at idle, its friction power over the class's efficiency.
;
; GEARS are the I-Shift ATO2612's twelve (11.73 down to the 0.79 overdrive in 1.26-1.30 steps, Volvo's
; body-builder instructions, docs/sources.md § Gearing) log-scaled onto this unit's span: D1 6.5 x
; final_drive 2.925 down to the 0.69 overdrive, 1.21-1.24 a step. ~1310 rpm at 88 km/h in D12, a real
; unit's cruise, and the governor, not the redline, sets top speed. The 1690 upshift lands at
; 1359-1392 rpm, clear of the 780 downshift, so no gear hunts. D1 pulls like a real unit's low
; start gear (the ATO's 1st-2nd on a ~2.6 axle and 0.5 m tyre, an estimate). The box picks its start
; gear up to D6 (start_gear_max) as an AMT does from gross weight and grade (Eaton, US 6,953,410):
; the highest whose floored launch locks the clutch within 1.5 s on the rig's mass and the drive
; axle's static grip (ShiftPolicy.start_gear). Bobtail D6 on the flat; with the 24 t box D3, and D1
; on 8 %.
;
; SHIFTING is the AMT's map (ShiftPolicy). 1690 / 780 is the full-pedal pair, where the launches are
; tuned. At a light pedal it upshifts at 1555, which lands each 1.21-1.24 step at 1250-1281 rpm, the
; bottom of the D13's 1250-1500 rpm cruise band (Volvo, "never specify ... above 1550", a cruise
; speed, not a shift point), each over 1.1x the 700 coast downshift (the landing floor, 958 on the
; widest step). The coast downshift sits over the 600 idle. Kickdown is I-Shift's switch past full
; travel (Volvo fact sheet and operator's manual), read as the last 5 % of the pedal (0.95). The dwell
; is EPA ALPHA's 1.5 s hold. Skip-shifts are I-Shift's: floored, the box passes the gears the rig
; would not hold for the dwell (ShiftPolicy.forced_upshift, on the rig's mass, the drive axle's
; grip and the cut's dead time): from its D6 start the bobtail skips D6>D8, the 24 t box D3>D5, each
; singly after. The shift's inertia phase spans 0.4 s, inside the shift cut (an estimate: no AMT figure
; found): the clutch brings the unfuelled crank down to the new gear at that rate instead of at its
; 4616 Nm rating. Once the clutch has locked and the cut ends, the fuel comes back over
; shift_torque_ramp_s 0.3 s, as an AMT ramps the engine's torque back after engagement (an estimate:
; no ramp-in figure found; Eaton's zero-torque dwell before disengagement is 150-300 ms,
; US 6,406,403). Stepped back in one tick,
; the drive rings the cab in pitch (docs/handling.md § Pitch).
;
; WHAT BOUNDS 2308 Nm IS TRACTION. Gear 1 puts 2308 x 6.5 x 2.925 x 0.9 / 0.36 = 110 kN at the tyres
; against ~66 kN of coupled drive-axle grip (92 kN of axle load x the M+S drive tyre's mu 0.80 x
; the 0.90 load-sensitivity factor), so the rig is ~1.65x traction-limited off the line and a
; bigger engine buys wheelspin.
;
; BRAKES ARE THE TRACTOR UNIT'S OWN HARDWARE, not derived from the tyre or from each other:
; - brake_torque 15500 a wheel: EBS disc brakes on a 7.1 t steer and 11.5 t drive axle, 2.2 g of
;   capacity bobtail (0.55 g of the 32 t rig on the tractor alone; the trailer brakes its own load).
;   One figure serves all four corners (no brake_bias_front), and the floored pedal asks every axle
;   for more than its tyre: abs_equipped holds each at the grip peak, as a real rig's ABS does.
;   Full pedal holds gear 1 at the 900 rpm launch target bobtail: BrakeSizing.stall_hold_margin
;   2.50 (2.57 on the conventional, whose longer wheelbase loads its axles differently).
; - handbrake_torque 12000 a wheel: the drive axle's spring brakes, 0.77 of the service brake on the
;   same drum. They lock the bobtail rears, so the unit's parking grade is its rear tyres'
;   (BrakeSizing.park_grade); coupled, the trailer's own spring brakes join them and the rig holds
;   UN R13's 18 % (docs/vehicle_measurements.md, measure:park). A unit whose air drains cannot drive away
;   because the box drops to neutral while they are on (Drivetrain.drive_inhibit), not because the
;   drums out-hold the engine.
; - retarder_rating_nm 1450 at the gearbox output: a hydraulic retarder at the low end of its class
;   (2500-3500 Nm on a 40 t tractor), 2120 Nm a drive wheel through the 2.925 final drive,
;   1.47 m/s^2 bobtail and 0.81 coupled to the 24 t box, whose brakes take the same share
;   (Drivetrain.retarder_fraction; tests/test_truck.gd pins the band bobtail).
; tcs_equipped is the rig's ASR, standard beside EBS: gear 1 puts ~102 kN on a driven axle that grips
; ~70 kN. Held in D1 (measure_vehicles semi 40 trace gear=1, coupled to the 24 t box, 2026-10-20)
; with it the AMT's clutch slips on its 900 rpm target and the drive tyres hold ~0.12 slip; without
; it (notc) the clutch locks within 0.2 s and the tyres spin past 0.4. The laden D3 start pushes
; ~65 kN, at the grip, so on dry asphalt the ASR does not act there (notc reaches 50 km/h in the
; same time): it is the equipment for a lower start gear and for low grip.
; hill_hold ASSIST (1) for hill_hold_s 3.0 is the AMT's hill-start aid, the brake-to-clutch rule: the
; brakes hold the rig after the pedal's release until the slipping clutch carries the grade with the
; trailer's mass (WheelDrive.towed_kg), or 3 s pass (Volvo VN). No converter creeps here: the clutch
; opens at a stop.
;
; trailer_bus_equipped IS THE ISO 7638 CONNECTOR'S DATA PAIR, a flag because the trailer bus is
; regional: this European unit has pins 6 and 7, so a coupled trailer claims and the ISO 11992
; cluster comes alive. A unit without it tows and brakes the same trailer identically through the
; pneumatic lines and publishes trailer_connected FALSE with zeros behind it.
;
; GEOMETRY is measured off semi.tscn: 5.45 m long (front bumper z -3.74 to rear bumper +1.71),
; wheelbase 3.60 (steer axle -2.65 under the cab, drive axle +0.95), 1.92 wide like the rest of the
; family. THE CAB SITS OVER THE STEER AXLE (it spans -3.60 .. -1.40) AND THE PLATE 0.50 m AHEAD OF THE
; DRIVE AXLE, both for the silhouette: a fifth wheel further back leaves a bare frame behind the cab
; and a metre of daylight to the trailer. Neither is free of the launch tune below.
;
; THE WHEELBASE IS SIZED BY THE LAUNCH, not the silhouette: the trailer pulls at the 1.05 m
; kingpin, and on a short unit that lever beats the steer axle's share of the weight (a 2.10 m
; wheelbase lifts BOTH front wheels for ~1 s of every full-throttle gear-1 launch; 3.60 keeps the
; axle loaded). Shortening it is a re-measure, not a styling choice.
;
; CENTRE OF MASS IS FORWARD OF CENTRE, which looks wrong until you couple it. A cab-over's own mass
; is cab and engine over the steer axle, so a BOBTAIL unit is front-heavy (steer share =
; (drive_z - com_z) / wheelbase). Coupled to the box, the plate's weight lands mostly on the drive
; axle: Articulation.rear_axle_share(kingpin_z, steer_z, drive_z), kingpin 0.50 m ahead of it. Both
; bands, plus the coupled steer axle's own floor, are pinned per tractor unit in
; tests/test_trailer.gd; with the COM further back the coupled steer axle carries too little and
; both front wheels leave the road under throttle in a corner.
;
; CENTRE OF MASS HEIGHT 0.90 IS ~1.03 m OVER THE ROAD COUPLED, ~1.10 m BOBTAIL (the body origin
; rides 0.13 m up coupled, 0.20 m bobtail on its less-compressed rear springs: measure_semi_launch's
; P5 kingpin_y 1.18 / 1.25 minus KINGPIN_LOCAL.y 1.05). A real tractor unit carries its mass about
; a metre up; a low COM leaves the unit unable to lean, transfer load or roll. The cost is real: the
; steer axle sheds weight under a gear-1 launch (the >= 8.5 kN floor is measured, and gated in CI)
; and the bobtail's rigid ceiling (0.65 g) sits under mu_lat 0.75. The levers are anti_roll_rate
; or mu_lat, never the height back down. Rollover thresholds: docs/truck.md § Truck sizing.
;
; anti_roll_rate 480000 (2x the front spring) is sized by the TRAILER, not the bobtail: the plate
; lets the two bodies roll only +-1.5 deg apart, so a tractor that leans further than its trailer
; twists the trailer over through it (at 240000 the flatbed's trailer lifted at 0.42 g, here 0.50).
; It also holds the bobtail flat enough to slide (~0.55 g) before it lifts a wheel in a steady turn.
;
; COMPROMISE: cornering_peak_load stays 0 (off) on the semis and their trailers, where the Kenney
; trucks run the truck tyre's 3.33. On, the tractor builds side force faster and out-leans its
; trailer: the 40 km/h full-lock step lifts the flatbed's trailer at 0.41 g (off: never) and every
; other trailer 0.003-0.013 g earlier. Undoing it means re-sizing this bar with the law on, then
; re-measuring every rollover row (docs/truck.md § Truck sizing). With the law on, the laden
; step's K also falls away from the criterion below (flatbed, 40 km/h, roll steer on: 0.72 > 0.02
; deg/g at 0.18 g).
;
; COMPROMISE: roll_steer_rear 0.10 on the leaf drive axle is TRUCK_BASE's fitted figure
; (gen_kenney_vehicles; docs/sources.md § Roll steer): the leaf axle's roll understeer is sourced,
; its size is not. Without it the step pass reads the bobtail at K 0.22 deg/g at 0.06 g, under the
; tractor criterion's 0.5-2.0 at 0.15 g (Woodrooffe & El-Gindy); with it 0.47-0.50 at 0.12-0.16 g,
; and laden (box) 0.14 at 0.13 g (-0.27 without), as load on the drive axle cuts a truck's K (UMTRI
; 1983). The laden 50 km/h 30 % lifted step lifts less (roll peak 37 > 16 deg); held, it rolls
; either way. No new rolled cell (measure_vehicles -- semi 60 step trailer=<bobtail|box>,
; 2026-10-23). Front 0: no figure.
;
; THE SPRINGS ARE SIZED PER AXLE: the rear carries the fifth-wheel load as well as its own, and the
; drive axle is the ONLY driven axle, so what the plate puts on it (kingpin_share, a 25-30 % band
; pinned in tests/test_trailer.gd) IS the rig's traction budget and the load the rear spring
; carries inside the 0.32 m travel. Front rate 240000 N/m is the truck family's; the rear is
; spring_rate_rear = 360000 (1.5x), from rear_load / (target_travel * rest_length) with the
; coupled-to-the-box drive corner as the load and ~40 % as the target, which splits the error
; between laden (a few tenths nose-up) and bobtail (a few tenths nose-down). tests/test_trailer.gd
; computes the travel fractions; measure_semi_launch reports the pose.
;
; FRONT DAMPERS ARE THE ROAD BAND'S ENDS AT THE BOBTAIL STEER CORNER. The steer axle parks 41.1 kN
; bobtail, ~2.1 t a corner: damper_bump 13500 / damper_rebound 17900 hold zeta = c / (2 sqrt(k m))
; at 0.30 / 0.40 there on the 240000 spring, the 0.3-0.4 band docs/handling.md § Pitch judges a
; launch against; coupled to the box (~2.5 t a corner) they read 0.27 / 0.36. The nose's rise at
; the take-up is the rebound's: at 15800 (0.35) the floored bobtail launch overshoots the trace's
; front-axle allowance, and neither the bump side nor the rear dampers move it (measure_vehicles
; semi 60 trace trailer=bobtail, 2026-10-20). An estimate: no steer-axle damping ratio is sourced
; for a tractor unit, so the band's ends stand in for one.
;
; REAR DAMPERS ARE SIZED FOR THE COUPLED CORNER, not the spring-scale rule. The rear axle's own load
; (own_rear_kg, ~1922 kg/corner bobtail) plus its share of a coupled trailer's kingpin load
; (kingpin_kg x rear_axle_share) puts ~3.5-4.7 t on each coupled rear corner (flatbed 14 t to box
; 24 t). damper_bump_rear 24700 / damper_rebound_rear 28800 hold zeta = c / (2 sqrt(k_rear * m))
; between 0.30 (box) and 0.40 (flatbed); tests/test_trailer.gd pins the band against the flatbed.
; At the bobtail corner mass the same numbers read zeta 0.47/0.55, over-damped on purpose (an
; unladen truck skates over bumps rather than pitch-rocks). GroundDriveSpec's fallback would size
; an UNSPECIFIED rear damper off the front-axle rule, which this axle's load outgrows.
;
; LOAD SENSITIVITY 0.08 IS WHERE THE PLATE LOAD SHOWS UP. RayWheel scales mu by
; `1 - 0.08 * log2(load / corner_mass*g)`, and corner_mass excludes the fifth-wheel share
; (truck/CLAUDE.md), so coupled to the box each drive wheel sits
; ~2.35x its reference and holds ~90 % of mu_long while the steer axle is untouched: the laden
; drive axle really losing grip, the conservative direction. Re-measure with
; tools/measure_semi_launch.tscn.

; TYRES: the TRUCK fit on its stock class, M+S drive (tyres/truck_drive.tres). mu_long / mu_lat and
; rolling_resistance below are that class on dry asphalt and a hard road; a fitted class (Winter,
; Mud: WheelDrive.fit_tyre) moves only its factors on them (TyreClass), never these brakes.

[ext_resource type="Script" path="res://src/vehicles/base/vehicle_spec.gd" id="1_spec"]
[ext_resource type="PackedScene" path="res://src/vehicles/kenney/wheel-truck.tscn" id="2_wheel"]
[ext_resource type="Script" path="res://src/vehicles/base/ground_drive_spec.gd" id="3_grounddrive"]
[ext_resource type="Resource" path="res://src/vehicles/tyres/truck_drive.tres" id="9_tyre"]

; DRAG AREA 2.18 m^2 = 0.70 (a flat-fronted cab-over) x 0.82 x the cab's own 1.92 x 1.98 box: the
; Cd x 0.82 x w x h recipe gen_kenney_vehicles derives every generated spec from, measured off
; semi.tscn's collision boxes. rolling_resistance 0.007 is a commercial radial.
;
; The trailer declares its OWN small drag area (box_spec 0.60, see there for the wake argument) and
; BOTH bodies apply their own aero, so a coupled rig resists tractor + trailer = 2.78 m^2, about
; 1.27x a bobtail.

; AERO CENTRE (0, 1.14, -1.75) is at the mid-height of semi.tscn's collision boxes (Lower + Upper:
; y 0.30-1.98), a quarter of the 3.60 m wheelbase ahead of the axles' midpoint (z -0.85), as
; gen_kenney_vehicles places every generated body's (SIDE_CP_FRAC: the side force's centre sits in
; the front half). Body space from the origin, never the COM.
;
; SIDE AREA 9.01 m^2 = 1.2 (broadside Cy) x 0.82 x those boxes' 5.45 x 1.68 side (z -3.74 to 1.71),
; the recipe gen_kenney_vehicles derives every generated spec from (docs/sources.md § Crosswind). It
; is the bobtail's own side; a coupled trailer applies its own full side (box_spec.tres).

[sub_resource type="Resource" id="Resource_grounddrive"]
script = ExtResource("3_grounddrive")
drag_area = 2.18
aero_centre = Vector3(0, 1.14, -1.75)
side_area = 9.01
rolling_resistance = 0.007
wheel_positions = PackedVector3Array(-0.72, 0.424, -2.65, 0.72, 0.424, -2.65, -0.62, 0.424, 0.95, 0.62, 0.424, 0.95)
wheel_radius = 0.36
wheel_inertia = 3.0
tyre_half_width = 0.21
wheel_scene = ExtResource("2_wheel")
driven_front = false
driven_rear = true
retarder_equipped = true
retarder_rating_nm = 1450.0
rest_length = 0.32
spring_rate = 240000.0
damper_bump = 13500.0
damper_rebound = 17900.0
spring_rate_rear = 360000.0
damper_bump_rear = 24700.0
damper_rebound_rear = 28800.0
anti_roll_rate = 480000.0
roll_steer_rear = 0.1
max_suspension_force = 120000.0
grip_curve = PackedVector2Array(0, 0, 0.12, 1, 0.4, 0.9, 1, 0.8)
tyre = ExtResource("9_tyre")
tyre_fit = 3
mu_long = 0.8
mu_lat = 0.75
load_sensitivity = 0.08
brake_torque = 15500.0
handbrake_torque = 12000.0
abs_equipped = true
tcs_equipped = true
hill_hold = 1
hill_hold_s = 3.0
max_steer_deg = 24.0
; ACKERMANN 1.0, an estimate: trucks set close to full for steer-tyre wear (SAE 861975, 912693; no
; figure sourced). The 24 deg lock is the bicycle angle: the inner wheel turns 26.0, the outer 22.2.
ackermann = 1.0
min_steer_frac = 0.21
steer_falloff_speed = 25.0

[resource]
script = ExtResource("1_spec")
mass = 8000.0
center_of_mass = Vector3(0, 0.9, -0.92)
ground_drive = SubResource("Resource_grounddrive")
trailer_bus_equipped = true
torque_curve = PackedVector2Array(600, 1500, 780, 1985, 1170, 2308, 1560, 2215, 1820, 1723, 2080, 577)
idle_rpm = 600.0
redline_rpm = 2080.0
gear_ratios = PackedFloat32Array(6.5, 5.316, 4.277, 3.5, 2.849, 2.327, 1.917, 1.568, 1.26, 1.031, 0.839, 0.69)
reverse_ratio = 6.0
final_drive = 2.925
efficiency = 0.9
engine_brake_frac = 0.15
engine_friction_frac = 0.05
fuel_type = 1
shift_cut_s = 0.4
shift_torque_ramp_s = 0.3
engine_inertia = 3.0
coupling = 1
clutch_reserve = 2.0
launch_rpm_over_idle = 300.0
shift_up_rpm = 1690.0
shift_down_rpm = 780.0
shift_up_light_rpm = 1555.0
shift_down_light_rpm = 700.0
kickdown_pedal = 0.95
shift_dwell_s = 1.5
skip_shifts = true
start_gear_max = 6
shift_handover_s = 0.4
; ROAD-SPEED GOVERNOR 90 km/h: the EU goods-vehicle limiter (Directive 92/6/EEC). It binds: coupled
; or bobtail the unit settles on it at 88-89 km/h (measure_vehicles), ~1310 rpm in the overdrive D12.
; It is the honest spec for a European artic.
speed_limit_kmh = 90.0
; HIGH-SPEED STEERING FALLOFF. 0.21 x 24 = 5.0 deg of usable lock at the floor, and the floor is set
; at 25 m/s = the 90 km/h limiter above, so the governed cruise sits on it. A coupled rig is the
; worst case for lock it cannot use: at 25 m/s mu_lat 0.75 holds only 2.4 deg of steady-state
; Ackermann on this 3.60 m wheelbase, so the 5.0 deg floor is 2.1x more lock than the tyre can use
; (test_a_steering_taper_never_out_limits_the_tyres in tests/test_vehicle_catalog.gd pins that
; ratio; a lower mu_lat only widens it). Yard work is untouched: 17.7 deg at 30 km/h, 20.8 at 15.
steer_speed = 1.8
headlight_paths = Array[NodePath]([NodePath("Lamps/HeadlightL"), NodePath("Lamps/HeadlightR")])
head_lamp_paths = Array[NodePath]([NodePath("Lamps/HeadLensL"), NodePath("Lamps/HeadLensR")])
brake_lamp_paths = Array[NodePath]([NodePath("Lamps/BrakeLampL"), NodePath("Lamps/BrakeLampR")])
turn_left_paths = Array[NodePath]([NodePath("Lamps/TurnLF"), NodePath("Lamps/TurnLR")])
turn_right_paths = Array[NodePath]([NodePath("Lamps/TurnRF"), NodePath("Lamps/TurnRR")])
