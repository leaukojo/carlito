[gd_resource type="Resource" script_class="VehicleSpec" load_steps=6 format=3]

; North American conventional (bonneted) tractor unit. HAND-AUTHORED like semi_spec.tres, and a
; VARIANT of it: the drivetrain, brake, handbrake, wheel, suspension and tyre blocks are
; semi_spec.tres's VERBATIM, so everything tests/test_truck.gd walks across the truck family (the
; retarder band, the stall hold, the parking grade, the retarder's slip-cap backstop margin) holds
; here by construction. What differs is GEOMETRY and one flag.
;
; trailer_bus_equipped IS DELIBERATELY ABSENT, and that absence is the whole variant. Europe puts a
; CAN pair on pins 6 and 7 of the ISO 7638 connector; North America has none, so trailer ABS status
; rides the POWER line (SAE J2497 / PLC4TRUCKS) as one lamp bit. This unit tows and brakes the same
; trailers through the same pneumatic lines and publishes trailer_connected FALSE with zeros behind
; it. The default is false, so an editor save drops the line below; the tests read the effective
; value, so that is harmless.
;
; GEOMETRY is measured off conventional.tscn: 6.10 m long (z -4.30 .. 1.80), wheelbase 4.40 (steer
; axle -3.35 behind the hood, drive axle +1.05), 1.92 wide like the rest of the family, kingpin
; (0, 1.05, 0.55). The COUPLING PLANE stays at y 1.05: every trailer in TrailerCatalog is authored
; against that height, so it is the one number a tractor-unit variant may not move. The wheelbase
; is sized like the cab-over's: long enough that the trailer's pull at the kingpin cannot unload
; the steer axle through a gear-1 launch (see semi_spec.tres).
;
; CENTRE OF MASS z -1.30 keeps the cab-over's front bias by the same arithmetic (steer share =
; (drive_z - com_z) / wheelbase); the bobtail and coupled bands are pinned alongside the
; cab-over's in tests/test_trailer.gd. The plate's load lands at kingpin z 0.55, 0.50 m ahead of
; the drive axle like the cab-over, and Articulation.rear_axle_share(kingpin_z, steer_z, drive_z)
; sends most of it there too. That fixed 0.50 m offset is a smaller fraction of the longer
; wheelbase, so relatively LESS of the plate reaches this steer axle: a long wheelbase trades
; traction for manners.
;
; CENTRE OF MASS HEIGHT 0.90 IS THE CAB-OVER'S NUMBER for the same reasons and lands the same place
; on this geometry (~1.03 m over the road). Only z separates the two units; see semi_spec.tres.
;
; SPRING RATES, DAMPING, TRAVEL AND THE ANTI-ROLL BAR ARE THE SEMI'S (240000 front / 360000 rear
; over 0.32 m, front dampers 13500 / 17900, rear 24700 / 28800, bar 480000), and they land the
; same band here: the fixed 0.50 m kingpin offset, not the wheelbase, sets the split, so the coupled
; rear corner carries about 3.5-4.7 t depending on the trailer. See semi_spec.tres for the
; derivation and damping ratios.
;
; ROLL STEER 0.10 ON THE DRIVE AXLE IS THE SEMI'S ESTIMATE (see semi_spec.tres): the step pass
; reads K 0.27 > 0.50 deg/g at 0.05 g bobtail, -0.59 > -0.22 at 0.12 g laden (box), no new rolled
; cell (measure_vehicles -- semi-conventional 60 step trailer=<bobtail|box>, 2026-10-23).
;
; load_sensitivity 0.08: commercial radials lose ~8 % of mu per doubling of load past the
; corner's static share. Family number, matching the semi.

; TYRES: the TRUCK fit on its stock class, M+S drive (tyres/truck_drive.tres). mu_long / mu_lat and
; rolling_resistance below are that class on dry asphalt and a hard road; a fitted class (Winter,
; Mud: WheelDrive.fit_tyre) moves only its factors on them (TyreClass), never these brakes.

[ext_resource type="Script" path="res://src/vehicles/base/vehicle_spec.gd" id="1_spec"]
[ext_resource type="PackedScene" path="res://src/vehicles/kenney/wheel-truck.tscn" id="2_wheel"]
[ext_resource type="Script" path="res://src/vehicles/base/ground_drive_spec.gd" id="3_grounddrive"]
[ext_resource type="Resource" path="res://src/vehicles/tyres/truck_drive.tres" id="9_tyre"]

; DRAG AREA 2.43 m^2 = 0.75 x 0.82 x the cab's 1.92 x 2.055 box (derived like semi_spec.tres): a
; bonneted conventional is taller AND blunter (0.75 against 0.70) than the cab-over, so it is the
; draggier unit pulling the identical trailer.

; AERO CENTRE (0, 1.18, -2.25) is at the mid-height of conventional.tscn's collision boxes (Lower,
; Cab, Hood: y 0.30-2.06), a quarter of the 4.40 m wheelbase ahead of the axles' midpoint (z -1.15),
; as semi_spec.tres. Body space from the origin, never the COM.
;
; SIDE AREA 10.56 m^2 = 1.2 x 0.82 x those boxes' 6.10 x 1.76 side (z -4.30 to 1.80), derived like
; semi_spec.tres.

[sub_resource type="Resource" id="Resource_grounddrive"]
script = ExtResource("3_grounddrive")
drag_area = 2.43
aero_centre = Vector3(0, 1.18, -2.25)
side_area = 10.56
rolling_resistance = 0.007
wheel_positions = PackedVector3Array(-0.72, 0.424, -3.35, 0.72, 0.424, -3.35, -0.62, 0.424, 1.05, 0.62, 0.424, 1.05)
wheel_radius = 0.36
wheel_inertia = 3.0
tyre_half_width = 0.21
wheel_scene = ExtResource("2_wheel")
driven_front = false
driven_rear = true
retarder_equipped = true
retarder_rating_nm = 1450.0
rest_length = 0.32
spring_rate = 240000.0
damper_bump = 13500.0
damper_rebound = 17900.0
spring_rate_rear = 360000.0
damper_bump_rear = 24700.0
damper_rebound_rear = 28800.0
anti_roll_rate = 480000.0
roll_steer_rear = 0.1
max_suspension_force = 120000.0
grip_curve = PackedVector2Array(0, 0, 0.12, 1, 0.4, 0.9, 1, 0.8)
tyre = ExtResource("9_tyre")
tyre_fit = 3
mu_long = 0.8
mu_lat = 0.75
load_sensitivity = 0.08
brake_torque = 15500.0
handbrake_torque = 12000.0
abs_equipped = true
tcs_equipped = true
; ESC as semi_spec.tres; the table is this geometry's own (StabilityControl.reference_table).
esc_equipped = true
esc_reference_k = PackedVector2Array(0.0906, 0.5132, 0.1803, 0.5439, 0.2679, 0.5954, 0.3527, 0.6684, 0.4338, 0.7603)
; Roll stability as semi_spec.tres, this unit's own lifts (`measure_semi_launch --
; semi-conventional trailer=<body|bobtail> ramp noesc notrsp`, 2026-11-06).
esc_roll_lift_g = PackedVector2Array(8000, 0.602, 11775, 0.552, 13123, 0.508, 13662, 0.457, 14471, 0.431)
hill_hold = 1
hill_hold_s = 3.0
; BRAKE HEAT (BrakeThermal; docs/sources.md § Brake heat): the 430 x 45 air disc's lump, every wheel.
brake_heat_capacity = 18000.0
brake_heat_capacity_rear = 18000.0
brake_cooling_g0 = 2.22
brake_cooling_g0_rear = 2.22
brake_cooling_g1 = 0.55
brake_cooling_g1_rear = 0.55
brake_emissivity = 0.82
brake_emissivity_rear = 0.82
brake_radiating_area = 0.277
brake_radiating_area_rear = 0.277
brake_fade_curve = 1
brake_fade_curve_rear = 1
max_steer_deg = 24.0
; ACKERMANN 1.0, as semi_spec.tres: the inner wheel turns 25.7 at the 24 deg lock, the outer 22.5.
ackermann = 1.0
min_steer_frac = 0.21
steer_falloff_speed = 29.0

[resource]
script = ExtResource("1_spec")
mass = 8000.0
center_of_mass = Vector3(0, 0.9, -1.30)
ground_drive = SubResource("Resource_grounddrive")
trailer_bus_equipped = false
torque_curve = PackedVector2Array(600, 1500, 780, 1985, 1170, 2308, 1560, 2215, 1820, 1723, 2080, 577)
idle_rpm = 600.0
redline_rpm = 2080.0
gear_ratios = PackedFloat32Array(6.5, 5.316, 4.277, 3.5, 2.849, 2.327, 1.917, 1.568, 1.26, 1.031, 0.839, 0.69)
reverse_ratio = 6.0
final_drive = 2.925
efficiency = 0.9
engine_brake_frac = 0.15
engine_friction_frac = 0.05
fuel_type = 1
shift_cut_s = 0.4
shift_torque_ramp_s = 0.3
engine_inertia = 3.0
coupling = 1
clutch_reserve = 2.0
launch_rpm_over_idle = 300.0
shift_up_rpm = 1690.0
shift_down_rpm = 780.0
shift_up_light_rpm = 1555.0
shift_down_light_rpm = 700.0
kickdown_pedal = 0.95
shift_dwell_s = 1.5
skip_shifts = true
start_gear_max = 6
shift_handover_s = 0.4
; ROAD-SPEED GOVERNOR 105 km/h: North American practice (no federal limiter mandate; fleets that
; fit one set it around 65 mph). Higher than the European unit by design, like the ISO 7638 split.
; It binds: the overdrive D12 would run on to ~140 km/h at redline; ~1560 rpm at 105.
speed_limit_kmh = 105.0
; HIGH-SPEED STEERING FALLOFF, the same 0.21 x 24 = 5.0 deg floor as the cab-over (same rack and
; mass). Only the floor SPEED differs: 29 m/s tracks this unit's higher 105 km/h limiter, so
; neither truck reaches its floor before its own cruise.
steer_speed = 1.8
headlight_paths = Array[NodePath]([NodePath("Lamps/HeadlightL"), NodePath("Lamps/HeadlightR")])
head_lamp_paths = Array[NodePath]([NodePath("Lamps/HeadLensL"), NodePath("Lamps/HeadLensR")])
brake_lamp_paths = Array[NodePath]([NodePath("Lamps/BrakeLampL"), NodePath("Lamps/BrakeLampR")])
turn_left_paths = Array[NodePath]([NodePath("Lamps/TurnLF"), NodePath("Lamps/TurnLR")])
turn_right_paths = Array[NodePath]([NodePath("Lamps/TurnRF"), NodePath("Lamps/TurnRR")])
