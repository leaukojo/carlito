[gd_resource type="Resource" script_class="VehicleSpec" load_steps=4 format=3]

; Box / curtainside semi-trailer running gear. A VehicleSpec because RayWheel consumes one; the
; drivetrain / steering fields are meaningless on a towed body and stay at their defaults.
;
; THE HEAVIEST TRAILER IN THE CATALOG, and mass is the ONLY thing that separates it from the
; flatbed (see box.gd). 24 000 kg against the flatbed's 14 000 is a 3.0 : 1 ratio against the
; 8 000 kg tractor unit, exactly the tested ceiling (src/vehicles/truck/CLAUDE.md § Fifth wheel,
; mass, axle loads); going past it needs re-verification, and test_trailer fails instead.
;
; Everything below is measured off box.tscn (origin AT THE KINGPIN, ground at y = -1.05):
;   - the tri-axle bogie is the family's: z 4.40 / 5.20 / 6.00, anchors at y = 0.424 - 1.05.
;   - center_of_mass z 3.798 puts 27.0 % on the fifth wheel ((5.20 - 3.798) / 5.20) = 6471 kg, of
;     which ~90 % lands on the tractor's drive axle. THE SHARE IS THE SAME 27 % ON ALL FOUR
;     TRAILERS: a real van semi-trailer puts 25-30 % of its weight on the plate, and the plate sits
;     on the tractor's SINGLE DRIVEN AXLE, so a 4x2's whole traction budget is what the plate hands
;     it. The rig is grip-limited, not power-limited, so plate share is worth more than any engine
;     number.
;   - center_of_mass y 0.55 is 1.60 m above the road: the shape of a LOADED van trailer (palletised
;     freight stacks toward the roof). That makes this the catalog's worst roller: half-track 0.72
;     over 1.60 m tips it at 0.45 g against mu_lat 0.75, so a laden box ROLLS BEFORE IT SLIDES and
;     takes the tractor with it over the ±1.5 deg plate. docs/heavy_vehicles.md § Truck sizing
;     carries the formula and why the family's narrow track reads every threshold low.
;   - spring_rate 249000 is sized off the load the bogie ACTUALLY carries, 17 527 kg: 28 656 N per
;     wheel compresses it 0.115 m of its 0.32 m travel (36 %), the same fraction every trailer sits
;     at. Re-derive it whenever the share moves (weight on the plate is weight off the bogie), or
;     the trailer rides high on an over-stiff spring; one sized for the full mass rides on its
;     stops.
;   - brake_torque 11355 is load-apportioned by the family's one formula, never copied:
;     10500 * (per-trailer-wheel kN / 26.5 kN per tractor wheel) = 10500 * 28.66 / 26.5, so every
;     trailer brakes at the same fraction of what it carries as the unit pulling it. Re-evaluate it
;     whenever the tractor's service brake moves (see semi_spec.tres).
;   - handbrake_torque 2839 IS THE RIG'S PARKING BRAKE. A semi-trailer's spring brakes sit on every
;     axle of the bogie and are applied by the same dash control as the tractor's; with
;     handbrake_torque 0 the rig is held by TWO tractor wheels and runs away downhill. It is a
;     quarter of this trailer's own service brake, the same load-apportioned fraction on all four:
;     6 wheels * 2839 / 0.36 = 47 kN, plus the tractor's 27 kN, holds a laden rig on a 24 % grade:
;     above the 18 % a combination must hold under UNECE R13 and far below a locked-wheel skid (the
;     bogie has ~190 kN of grip), so the parking brake is brake-limited like a real one.
;
; load_sensitivity 0.08 matches the towing unit. A trailer's axles carry LESS than their even static
; share once the plate takes its cut, so they sit below the reference and gain a few per cent of
; mu, the mirror image of what the drive axle loses.

[ext_resource type="Script" path="res://src/vehicles/base/vehicle_spec.gd" id="1_spec"]
[ext_resource type="Script" path="res://src/vehicles/base/ground_drive_spec.gd" id="2_grounddrive"]

; DRAG AREA 0.60 m^2 IS A MARGINAL AREA, NOT THIS BODY'S FRONTAL AREA. The van is 1.86 x 1.6 above
; the deck (2.4 m^2) but runs in the tractor's wake, so it adds roughly a quarter of that. That
; makes a coupled rig resist ~1.27x a bobtail (see semi_spec.tres and VehicleMath's road-resistance
; header). Never set it to the real box.

[sub_resource type="Resource" id="Resource_grounddrive"]
script = ExtResource("2_grounddrive")
drag_area = 0.6
rolling_resistance = 0.007
wheel_positions = PackedVector3Array(-0.72, -0.626, 4.4, 0.72, -0.626, 4.4, -0.72, -0.626, 5.2, 0.72, -0.626, 5.2, -0.72, -0.626, 6, 0.72, -0.626, 6)
wheel_radius = 0.36
wheel_inertia = 3.0
driven_front = false
driven_rear = false
rest_length = 0.32
spring_rate = 249000.0
damper_bump = 13100.0
damper_rebound = 17650.0
max_suspension_force = 110000.0
grip_curve = PackedVector2Array(0, 0, 0.12, 1, 0.4, 0.9, 1, 0.8)
mu_long = 0.8
mu_lat = 0.75
load_sensitivity = 0.08
brake_torque = 11355.0
handbrake_torque = 2839.0

[resource]
script = ExtResource("1_spec")
mass = 24000.0
center_of_mass = Vector3(0, 0.55, 3.798)
ground_drive = SubResource("Resource_grounddrive")

; LAMPS: a towed body uses only the rear tier (TAIL) and the markers, so head_lamp_paths stays
; empty. The bits ride the tractor's VehicleInput and SemiTractor hands them down each tick, so
; both ends light off one source with no blink timer here.
brake_lamp_paths = Array[NodePath]([NodePath("TailLensL"), NodePath("TailLensR")])
turn_left_paths = Array[NodePath]([NodePath("TurnLensL")])
turn_right_paths = Array[NodePath]([NodePath("TurnLensR")])
steady_lamp_paths = Array[NodePath]([NodePath("MarkerLensL"), NodePath("MarkerLensR")])
