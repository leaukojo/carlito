[gd_resource type="Resource" script_class="VehicleSpec" load_steps=4 format=3]

; Tipper / dump semi-trailer running gear. A VehicleSpec because RayWheel consumes one; the
; drivetrain / steering fields are meaningless on a towed body and stay at their defaults.
;
; Everything below is measured off tipper.tscn (origin AT THE KINGPIN, ground at y = -1.05):
;   - the tri-axle bogie is the family's: z 4.40 / 5.20 / 6.00, anchors at y = 0.424 - 1.05.
;   - center_of_mass z 3.798 puts 27.0 % on the fifth wheel ((5.20 - 3.798) / 5.20) = 5123 kg — the
;     catalog-wide realistic plate share (see box_spec.tres), which is what feeds the 4x2's single
;     driven axle.
;   - center_of_mass y 0.25 is 1.30 m above the road: the payload rides IN a body whose floor is at
;     y -0.10 (0.95 m over the road) and whose sides top out at 2.04 m. Half-track 0.72 over 1.30 m
;     tips it at 0.55 g against mu_lat 0.75, roll-first laden like the box and the tanker. THE RAISED
;     BODY TAKES IT HIGHER STILL; see tipper.gd's TIP_COM_RISE_Y.
;   - THE TIP MOVES IT. tipper.gd walks the centre of mass 0.90 m rearward at full tip, taking the
;     fifth wheel's share from 27.0 % down to 10.5 %: 3135 kg off the tractor's drive axle and onto
;     the trailer's bogie, a real centre of mass move rather than a term on either axle-load signal.
;     At full tip the bogie sits at 44 % of its travel against 36 % parked; the spring below covers
;     both ends.
;   - spring_rate 197000 is sized off the load the bogie ACTUALLY carries parked, 13 875 kg:
;     22 686 N per wheel compresses it 0.115 m of its 0.32 m travel (36 %), the family's fraction.
;   - brake_torque 8990 is load-apportioned by the family's one formula, never copied:
;     10500 * (22.69 kN per trailer wheel / 26.5 kN per tractor wheel).
;   - handbrake_torque 2247 is the bogie's SPRING PARKING BRAKE, a quarter of this trailer's own
;     service brake like every trailer here (derivation: box_spec.tres). The tip interlock wants a
;     parking brake.
;
; load_sensitivity 0.08 matches the towing unit. A trailer's axles carry LESS than their even static
; share once the plate takes its cut, so they sit below the reference and gain a few per cent of
; mu, the mirror image of what the drive axle loses.

[ext_resource type="Script" path="res://src/vehicles/base/vehicle_spec.gd" id="1_spec"]
[ext_resource type="Script" path="res://src/vehicles/base/ground_drive_spec.gd" id="2_grounddrive"]

; DRAG AREA 0.55 m^2: a marginal, in-the-wake figure like every trailer's (see box_spec.tres), a
; little under the box van's (open-topped, slightly lower). Raising the body does not raise it: the
; aero model reads the spec, not the pose.

[sub_resource type="Resource" id="Resource_grounddrive"]
script = ExtResource("2_grounddrive")
drag_area = 0.55
rolling_resistance = 0.007
wheel_positions = PackedVector3Array(-0.72, -0.626, 4.4, 0.72, -0.626, 4.4, -0.72, -0.626, 5.2, 0.72, -0.626, 5.2, -0.72, -0.626, 6, 0.72, -0.626, 6)
wheel_radius = 0.36
wheel_inertia = 3.0
driven_front = false
driven_rear = false
rest_length = 0.32
spring_rate = 197000.0
damper_bump = 10700.0
damper_rebound = 14400.0
max_suspension_force = 90000.0
grip_curve = PackedVector2Array(0, 0, 0.12, 1, 0.4, 0.9, 1, 0.8)
mu_long = 0.8
mu_lat = 0.75
load_sensitivity = 0.08
brake_torque = 8990.0
handbrake_torque = 2247.0

[resource]
script = ExtResource("1_spec")
mass = 19000.0
center_of_mass = Vector3(0, 0.25, 3.798)
ground_drive = SubResource("Resource_grounddrive")

; LAMPS: a towed body uses only the rear tier (TAIL) and the markers, so head_lamp_paths stays
; empty. The bits ride the tractor's VehicleInput and SemiTractor hands them down each tick, so
; both ends light off one source with no blink timer here.
brake_lamp_paths = Array[NodePath]([NodePath("TailLensL"), NodePath("TailLensR")])
turn_left_paths = Array[NodePath]([NodePath("TurnLensL")])
turn_right_paths = Array[NodePath]([NodePath("TurnLensR")])
steady_lamp_paths = Array[NodePath]([NodePath("MarkerLensL"), NodePath("MarkerLensR")])
