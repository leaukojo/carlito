[gd_resource type="Resource" script_class="VehicleSpec" load_steps=5 format=3]

; Flatbed semi-trailer running gear. A VehicleSpec because RayWheel consumes one; the drivetrain /
; steering fields are meaningless on a towed body and stay at their defaults.
;
; Everything below is measured off flatbed.tscn (origin AT THE KINGPIN, ground at y = -1.05):
;   - the tri-axle bogie sits at z 4.40 / 5.20 / 6.00, so the bogie centre is 5.20 m behind the
;     coupling and the anchors are at y = 0.424 - 1.05 = -0.626 (the truck family's hub height).
;   - center_of_mass z 3.798 puts 27.0 % of the trailer's weight on the fifth wheel
;     ((5.20 - 3.798) / 5.20), i.e. 3775 kg onto the tractor's drive axle — the catalog-wide
;     realistic plate share (see box_spec.tres), and the reason axle_load rises the moment you
;     couple. On a 4x2 that load IS the traction budget.
;   - center_of_mass y -0.15 is 0.90 m above the road, the LOWEST in the catalog and the only
;     trailer that still slides before it rolls (half-track 0.72 over 0.90 m tips at 0.80 g, clear
;     of mu_lat 0.75): a flatbed's load sits ON the 1.05 m deck, not stacked inside a body.
;   - spring_rate 145000 is sized so the 10 224 kg the bogie actually carries compresses it 0.115 m
;     of its 0.32 m travel (36 %). A spring sized for the FULL mass rides on its stops.
;   - brake_torque 8974 is load-apportioned against the tractor unit, never copied: a full demand
;     brakes the 10 225 kg bogie at the 1.49 g the semi's brakes (4 x 15500 / 0.36) make on its
;     coupled static load, 8000 + 3774 kg on the plate (derivation: box_spec.tres; test_trailer).
;   - handbrake_torque 2243 is the bogie's SPRING PARKING BRAKE, a quarter of this trailer's own
;     service brake like every trailer here (derivation: box_spec.tres).
;
; load_sensitivity 0.08 matches the towing unit. A trailer's axles carry LESS than their even static
; share once the plate takes its cut, so they sit below the reference and gain a few per cent of
; mu, the mirror image of what the drive axle loses.

; TYRES: the TRAILER fit on the Trailer class, the reference row (tyres/trailer.tres), which a towed
; body keeps (TowedBody). mu_long / mu_lat and rolling_resistance below are that class on dry
; asphalt and a hard road.

[ext_resource type="Script" path="res://src/vehicles/base/vehicle_spec.gd" id="1_spec"]
[ext_resource type="Script" path="res://src/vehicles/base/ground_drive_spec.gd" id="2_grounddrive"]
[ext_resource type="Resource" path="res://src/vehicles/tyres/trailer.tres" id="9_tyre"]

; DRAG AREA 0.25 m^2: a marginal, in-the-wake figure like every trailer's (see box_spec.tres), the
; smallest in the catalog because an EMPTY deck has almost nothing standing in the air. It is the
; deck and its headboard only; a load's own aero is not modeled.

; AERO CENTRE (0, 0.11, 2.65) is the centre of flatbed.tscn's collision boxes less the bogie (Frame,
; Neck, Headboard: y -0.58 to 0.79, z -1.15 to 6.45), kept at the centre like box_spec.tres's.
; Body space from the origin, never the COM.
;
; SIDE AREA 3.95 m^2 is the full side (see box_spec.tres): 1.2 x the same boxes' side, Frame 4.85 x
; 0.55 + Neck 2.75 x 0.2 + Headboard 0.12 x 0.6 = 3.29 m^2. An empty deck shows a crosswind little
; more than its rails; the solid Frame box overstates the open chassis under it (estimate).

[sub_resource type="Resource" id="Resource_grounddrive"]
script = ExtResource("2_grounddrive")
drag_area = 0.25
aero_centre = Vector3(0, 0.11, 2.65)
side_area = 3.95
rolling_resistance = 0.007
wheel_positions = PackedVector3Array(-0.72, -0.626, 4.4, 0.72, -0.626, 4.4, -0.72, -0.626, 5.2, 0.72, -0.626, 5.2, -0.72, -0.626, 6, 0.72, -0.626, 6)
wheel_radius = 0.36
wheel_inertia = 3.0
tyre_half_width = 0.21
driven_front = false
driven_rear = false
rest_length = 0.32
spring_rate = 145000.0
damper_bump = 7700.0
damper_rebound = 10400.0
anti_roll_rate = 145000.0
max_suspension_force = 70000.0
grip_curve = PackedVector2Array(0, 0, 0.12, 1, 0.4, 0.9, 1, 0.8)
tyre = ExtResource("9_tyre")
tyre_fit = 6
mu_long = 0.8
mu_lat = 0.75
load_sensitivity = 0.08
brake_torque = 8974.0
handbrake_torque = 2243.0
abs_equipped = true

[resource]
script = ExtResource("1_spec")
mass = 14000.0
center_of_mass = Vector3(0, -0.15, 3.798)
ground_drive = SubResource("Resource_grounddrive")

; LAMPS: a towed body uses only the rear tier (TAIL) and the markers, so head_lamp_paths stays
; empty. The bits ride the tractor's VehicleInput and SemiTractor hands them down each tick, so
; both ends light off one source with no blink timer here.
brake_lamp_paths = Array[NodePath]([NodePath("TailLensL"), NodePath("TailLensR")])
turn_left_paths = Array[NodePath]([NodePath("TurnLensL")])
turn_right_paths = Array[NodePath]([NodePath("TurnLensR")])
steady_lamp_paths = Array[NodePath]([NodePath("MarkerLensL"), NodePath("MarkerLensR")])
