[gd_scene load_steps=8 format=3]

; The tractor's rear drawbar: a hanger off the bottom of the hitch housing, a bar running aft on
; the centreline under the PTO stub, and the pin the trailer's eye drops over. Hand-built low-poly
; to match the kit's flat-shaded look, like every implement and trailer in the project.
;
; AUTHORED IN THE CHASSIS' OWN FRAME (the scene is instanced at identity on the tractor body), so
; every position below is a chassis coordinate and `Pin`'s position IS the coupling datum that
; Drawbar reads. Measured against the Kenney tractor body and three_point_hitch.tscn:
;   - ground is y ~ 0 at ride height and the body ends near the centreline at z ~ 0.99;
;   - the hitch housing case occupies x +-0.20, y 0.335 .. 0.755, z 0.88 .. 1.12, so the bar starts
;     at z 1.15 rather than running through it;
;   - the PTO stub is on the centreline at y 0.60 out to z ~ 1.22, so the bar's top at y 0.45
;     passes 0.10 m beneath it;
;   - the lower draft links splay to their ball ends at |x| 0.37, and lowered they sit at y 0.21,
;     z 1.72 -- below and behind the bar, which is why the linkage can work with a trailer hitched.
;
; NO CollisionShape, and no RigidBody: this is tractor anatomy on the chassis body, exactly like
; ThreePointHitch. The joint Drawbar builds is what holds a trailer on, and it is built in code at
; `Pin` so the steel and the anchor cannot disagree.

[ext_resource type="Script" path="res://src/vehicles/tractor/drawbar.gd" id="1_drawbar"]

[sub_resource type="StandardMaterial3D" id="MatCast"]
resource_name = "drawbar_cast"
albedo_color = Color(0.24, 0.26, 0.29, 1)
roughness = 0.8

[sub_resource type="StandardMaterial3D" id="MatSteel"]
resource_name = "drawbar_steel"
albedo_color = Color(0.6, 0.63, 0.67, 1)
metallic_specular = 0.5
roughness = 0.55

; The hanger casting under the housing. It overlaps the housing case rather than butting onto it —
; parts of one machine may interpenetrate freely, it is COPLANAR faces with a shared facing that
; z-fight (see src/vehicles/CLAUDE.md).
[sub_resource type="BoxMesh" id="MeshHanger"]
material = SubResource("MatCast")
size = Vector3(0.3, 0.16, 0.16)

; The bar. 0.68 long from z 1.15 to 1.83, with 0.23 of it behind the pin — a real drawbar carries
; its hole well short of the end so the steel around it is not a tab.
[sub_resource type="BoxMesh" id="MeshBar"]
material = SubResource("MatSteel")
size = Vector3(0.16, 0.1, 0.68)

; The two straps that hang the bar off the hanger. They reach inboard to |x| 0.06, so they overlap
; the bar's own 0.08 rather than stopping on its face.
[sub_resource type="BoxMesh" id="MeshStay"]
material = SubResource("MatCast")
size = Vector3(0.12, 0.26, 0.1)

[sub_resource type="CylinderMesh" id="MeshPinShank"]
material = SubResource("MatSteel")
top_radius = 0.032
bottom_radius = 0.032
height = 0.24
radial_segments = 8
rings = 1

[sub_resource type="CylinderMesh" id="MeshPinHead"]
material = SubResource("MatSteel")
top_radius = 0.055
bottom_radius = 0.055
height = 0.06
radial_segments = 8
rings = 1

[node name="Drawbar" type="Node3D"]
script = ExtResource("1_drawbar")

[node name="Hanger" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.36, 1.16)
mesh = SubResource("MeshHanger")

[node name="Bar" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.4, 1.49)
mesh = SubResource("MeshBar")

[node name="StayL" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.12, 0.42, 1.3)
mesh = SubResource("MeshStay")

[node name="StayR" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.12, 0.42, 1.3)
mesh = SubResource("MeshStay")

[node name="PinShank" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.42, 1.6)
mesh = SubResource("MeshPinShank")

[node name="PinHead" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.56, 1.6)
mesh = SubResource("MeshPinHead")

; THE COUPLING DATUM. Drawbar reads this marker's position in _ready — move it and the joint, the
; coupled pose and the trailer's authored ground all move together.
[node name="Pin" type="Marker3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.4, 1.6)
