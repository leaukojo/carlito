roughness = 0.75

[sub_resource type="StandardMaterial3D" id="MatSteel"]
resource_name = "plough_steel"
albedo_color = Color(0.3, 0.33, 0.37, 1)
metallic_specular = 0.55
roughness = 0.55

; Shares, mouldboards and coulters: polished by the soil, and the one thing the player is
; meant to watch cross the ground line. Deliberately the brightest material on the machine.
[sub_resource type="StandardMaterial3D" id="MatEdge"]
resource_name = "plough_share"
albedo_color = Color(0.84, 0.86, 0.89, 1)
metallic_specular = 0.7
roughness = 0.35

[sub_resource type="BoxMesh" id="MeshRiser"]
material = SubResource("MatPaint")
size = Vector3(0.18, 0.5, 0.18)

[sub_resource type="BoxMesh" id="MeshBeam"]
material = SubResource("MatPaint")
size = Vector3(0.18, 0.22, 3.4145)

[sub_resource type="BoxMesh" id="MeshBracket"]
material = SubResource("MatPaint")
size = Vector3(0.36, 0.11, 0.12)

[sub_resource type="BoxMesh" id="MeshLegUpper"]
material = SubResource("MatPaint")
size = Vector3(0.077, 0.42, 0.224)

[sub_resource type="BoxMesh" id="MeshLegLower"]
material = SubResource("MatPaint")
size = Vector3(0.077, 0.336, 0.196)

; The frog: the casting the share, the mouldboard and the landside all bolt to. Without it the
; three plates read as loose flags rather than one body.
[sub_resource type="BoxMesh" id="MeshFrog"]
material = SubResource("MatPaint")
size = Vector3(0.168, 0.168, 0.28)

; The share point: a triangular prism in PLAN view, laid flat so its apex leads. That is the
; real shape of a plough point and it costs three triangles more than a box.
[sub_resource type="PrismMesh" id="MeshShare"]
material = SubResource("MatEdge")
size = Vector3(0.392, 0.448, 0.14)

; The mouldboard, as three plates standing progressively more upright: the real part is one
; twisted surface that lifts the slice and rolls it to the RIGHT, and a staircase of three
; flat plates is the low-poly way to say that. They are plates, not slabs — but thick enough
; to catch the light on their edge, or they read as paper from the chase camera.
[sub_resource type="BoxMesh" id="MeshMouldLow"]
material = SubResource("MatEdge")
size = Vector3(0.476, 0.07, 0.476)

[sub_resource type="BoxMesh" id="MeshMouldMid"]
material = SubResource("MatEdge")
size = Vector3(0.42, 0.07, 0.448)

