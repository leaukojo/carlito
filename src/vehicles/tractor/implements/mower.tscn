[gd_scene load_steps=26 format=3]

; Rotary mower (mounted 7 ft rotary cutter) on a Category 2 headstock. Authored in the LOWERED
; (working) pose with the origin ON THE LOWER PIN LINE, the frame HitchLinkage solves against;
; ground is y = -0.21 in this frame, so the tail wheel rests exactly on it and the blades sweep
; 0.055 m above it. The top link floats on a cutter like this, so the tail wheel and the lower
; pins carry the deck between them (mower.gd's ground share is that lever).
;
; The blades are the point of this machine — they are what 'pto_rpm' looks like. So the rear
; chain guard is a ROW OF HANGING BARS rather than a closed skirt, and the blade plane sits
; just below the bars' bottom edge: from the chase camera you see the rotor turning through
; the gaps, and with the hitch raised the whole underside is on show. One blade is painted the
; same index red as the tractor's PTO stub spline, because a symmetric spinning part reads as
; standing still.
;
; The telescoping driveshaft from the tractor's PTO stub to this gearbox is NOT modelled (the
; one mechanical part left out, same as on every implement); the input shaft angling forward
; and up out of the gearbox toward the stub is. NO CollisionShape: implements are visual.

[ext_resource type="Script" path="res://src/vehicles/tractor/implements/mower.gd" id="1_mower"]
[ext_resource type="PackedScene" path="res://src/vehicles/tractor/implements/headstock.tscn" id="2_head"]

[sub_resource type="StandardMaterial3D" id="MatPaint"]
resource_name = "mower_paint"
albedo_color = Color(0.87, 0.42, 0.13, 1)
roughness = 0.75

[sub_resource type="StandardMaterial3D" id="MatSteel"]
resource_name = "mower_steel"
albedo_color = Color(0.3, 0.33, 0.37, 1)
metallic_specular = 0.55
roughness = 0.55

; The rotor lives in the deck's shadow, so it is deliberately the BRIGHTEST thing on the
; machine — a dark rotor under a dark deck reads as a black gap from the chase camera.
[sub_resource type="StandardMaterial3D" id="MatBlade"]
resource_name = "mower_blades"
albedo_color = Color(0.86, 0.88, 0.9, 1)
metallic_specular = 0.7
roughness = 0.4

[sub_resource type="StandardMaterial3D" id="MatMark"]
resource_name = "index_mark"
albedo_color = Color(0.85, 0.18, 0.14, 1)
roughness = 0.6

[sub_resource type="BoxMesh" id="MeshRail"]
material = SubResource("MatPaint")
size = Vector3(0.1, 0.1, 0.34)

; The deck is very nearly square, because it has to COVER the blade circle: the rotor sweeps
; 2.14 m across, so a shallower deck would leave the blades scything out past the front and
; rear edges.
