; The packer roller carries the machine and sets its working depth, so it rests exactly on the
; ground — but it is deliberately kept SMALL and set well back on its arms: any bigger and it
; blocks the line of sight from the chase camera into the gap under the hood, which is the
; only place the spinning tines can be seen.
[sub_resource type="CylinderMesh" id="MeshRoller"]
material = SubResource("MatSteel")
top_radius = 0.13
bottom_radius = 0.13
height = 1.22
radial_segments = 8
rings = 0

