[gd_resource type="Resource" script_class="VehicleSpec" load_steps=4 format=3]

; Drawbar tipping trailer running gear. A VehicleSpec because that is what RayWheel consumes; the
; drivetrain / steering fields are meaningless on a towed body and stay at their defaults.
;
; Everything below is measured off farm_tipper.tscn (ORIGIN AT THE DRAWBAR EYE, ground at
; y = -0.40; datum rule: tractor/CLAUDE.md). The trailer hangs off the tractor's own drawbar
; (Drawbar.PIN_LOCAL, read off drawbar.tscn's Pin marker).
;
;   - the tandem bogie sits at z 3.30 / 3.95, so the bogie centre is 3.625 m behind the eye, and the
;     anchors are at y = 0.424 - 0.40 = 0.024 (the same 0.424 hub height the truck family's wheels
;     use, because it is the same 0.36 m wheel).
;   - center_of_mass z 3.19 puts 12.0 % of the trailer's weight on the drawbar
;     ((3.625 - 3.19) / 3.625), i.e. 1200 kg onto the tractor. THAT IS THE CONTRAST WITH THE SEMI,
;     which puts 27 % on its plate: a drawbar carries a nose weight, not a share. A tandem farm
;     trailer really does run 10-15 %, and the tractor gets correspondingly less help gripping —
;     which is why it slips pulling this where the semi's drive axle was being fed by its trailer.
;   - center_of_mass y 0.35 is 0.75 m above the road: the body sits OVER the wheels on this trailer
;     (a farm tipper is not a low-deck semi), so the mass rides higher than the flatbed's 0.50.
;   - spring_rate 187000 is sized off the load the bogie ACTUALLY carries, 8800 kg: 21 582 N per
;     wheel compresses it 0.115 m of its 0.32 m travel (36 %), which is where every trailer in the
;     project sits parked. A spring sized for the FULL mass would ride on its stops.
;   - brake_torque 9229 is load-apportioned against the TRACTOR that pulls it: a full demand brakes
;     the 8800 kg bogie at the 1.19 g the tractor's brakes (4 x 8600 / 0.36) make on its coupled
;     static load, 7000 + 1200 kg on the drawbar, so the two brake alike and the trailer never
;     pushes the tractor (test_drawbar_trailer). Like the tractor's it is past the tyre (1.0 x
;     21 560 N x 0.36 = 7762 Nm): an ABS-less bogie locks at full pedal, as the tractor's rears do.
;   - handbrake_torque 2307 is a quarter of this trailer's own service brake, the family rule. It
;     is not what parks the rig: the tractor's two rear wheels alone hold the 17 t combination on
;     UNECE R13's 18 % (2 x 8000 / 0.36 = 44.4 kN against 17 t x g x sin(atan 0.18) = 29.5 kN, a
;     1.5 margin; measured 2026-10-08, the lever set: 2.9 mm moved in 60 s as shipped, 2.6 mm with
;     this at 0). The tip interlock wants the lever set before the body moves, and the lever
;     applies this too.
;
; load_sensitivity 0.08 matches the towing unit. A trailer's axles carry LESS than their even
; static share once the plate/drawbar takes its cut, so they sit below the reference and gain a
; few per cent of mu — the mirror image of what the drive axle loses.

[ext_resource type="Script" path="res://src/vehicles/base/vehicle_spec.gd" id="1_spec"]
[ext_resource type="Script" path="res://src/vehicles/base/ground_drive_spec.gd" id="2_grounddrive"]

; DRAG AREA 0.45 m^2 — a MARGINAL, in-the-wake figure like every trailer's, never the silhouette.
; The real frontal area of a 1.9 x 1.8 m body is over 3 m^2; what it adds behind a tractor that is
; already punching that hole is the body sides standing above the tractor's own roofline and the
; open top catching air. Set to the silhouette instead and the combination is over-braked by drag.
;
; ROLLING RESISTANCE 0.014 — deliberately NOT the semi-trailers' 0.007. This runs implement tyres,
; which sit between a truck's ribbed trailer tyre and the tractor's own 0.02 agricultural tread.
; Both terms are declared: nothing in this project rides physics/3d/default_linear_damp, and a
; towed body is the one that proved why (see TowedBody._ready).

[sub_resource type="Resource" id="Resource_grounddrive"]
script = ExtResource("2_grounddrive")
drag_area = 0.45
rolling_resistance = 0.014
wheel_positions = PackedVector3Array(-0.78, 0.024, 3.3, 0.78, 0.024, 3.3, -0.78, 0.024, 3.95, 0.78, 0.024, 3.95)
wheel_radius = 0.36
wheel_inertia = 3.0
driven_front = false
driven_rear = false
rest_length = 0.32
spring_rate = 187000.0
damper_bump = 9900.0
damper_rebound = 13400.0
max_suspension_force = 90000.0
grip_curve = PackedVector2Array(0, 0, 0.12, 1, 0.4, 0.9, 1, 0.8)
mu_long = 1.0
mu_lat = 0.95
load_sensitivity = 0.08
brake_torque = 9229.0
handbrake_torque = 2307.0

[resource]
script = ExtResource("1_spec")
mass = 10000.0
center_of_mass = Vector3(0, 0.35, 3.19)
ground_drive = SubResource("Resource_grounddrive")

; LAMPS — the one group of lamp fields a towed body DOES use, resolved by the trailer's own LampSet
; against its own root. No headlamps and no beam, so head_lamp_paths stays empty and `lights` only
; ever picks the rear tier and the markers.
; The bits arrive on the tractor's VehicleInput and are handed down each tick, so a braking or
; indicating combination lights at BOTH ends off one authoritative source — no second signal, no
; side channel, and no blink timer of its own.
brake_lamp_paths = Array[NodePath]([NodePath("TailLensL"), NodePath("TailLensR")])
turn_left_paths = Array[NodePath]([NodePath("TurnLensL")])
turn_right_paths = Array[NodePath]([NodePath("TurnLensR")])
steady_lamp_paths = Array[NodePath]([NodePath("MarkerLensL"), NodePath("MarkerLensR")])
