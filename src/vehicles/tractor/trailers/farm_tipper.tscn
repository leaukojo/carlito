; --- the drawbar: eye, tongue, riser and the plate that ties it into the frame -------------------
; The tongue runs at PIN HEIGHT (y 0 in this frame) and the frame rides 0.36 higher, so the riser
; between them is what a real farm trailer's swan neck is. Every part overlaps its neighbour rather
; than butting onto its face: coplanar faces with a shared facing are what z-fight.

[sub_resource type="BoxMesh" id="MeshEye"]
material = SubResource("MatSteel")
size = Vector3(0.22, 0.18, 0.14)

[sub_resource type="BoxMesh" id="MeshTongue"]
material = SubResource("MatFrame")
size = Vector3(0.16, 0.14, 1.2)

[sub_resource type="BoxMesh" id="MeshRiser"]
material = SubResource("MatFrame")
size = Vector3(0.2, 0.46, 0.16)

[sub_resource type="BoxMesh" id="MeshHitchPlate"]
material = SubResource("MatFrame")
size = Vector3(0.44, 0.14, 0.34)

