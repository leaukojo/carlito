; The SAME box, swept 45 deg about the hinge at (0, 0.60, 4.95). Derived, not eyeballed:
;   local centre (0, 0.37, -1.91) -> y' = 0.7071 * (0.37 + 1.91) = 1.61219
;                                    z' = 0.7071 * (0.37 - 1.91) = -1.08894
;   so the origin is (0, 0.60 + 1.61219, 4.95 - 1.08894) = (0, 2.21219, 3.86106).
; test_drawbar_trailer re-derives it from CollisionTipBody and fails if the two drift apart.
[node name="CollisionTipBodyRaised" type="CollisionShape3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 0.70710678, -0.70710678, 0, 0.70710678, 0.70710678, 0, 2.21219, 3.86106)
shape = SubResource("ShapeTipBody")
disabled = true

