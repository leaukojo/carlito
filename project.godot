[layer_names]

3d_physics/layer_1="Terrain"
3d_physics/layer_2="Drivable"
3d_physics/layer_3="Props"
3d_physics/layer_4="Vehicle"
3d_physics/layer_5="Payload"
3d_physics/layer_6="Containment"
3d_physics/layer_7="Trigger"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d.web=0
lights_and_shadows/positional_shadow/soft_shadow_filter_quality.web=0
lights_and_shadows/positional_shadow/atlas_size.web=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.web=0
lights_and_shadows/directional_shadow/size.web=2048
